    <%- include("../partials/admin/footer.ejs") %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // View booking details
                document.querySelectorAll('.view-details-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const booking = JSON.parse(btn.dataset.booking);

                        // Customer info
                        document.getElementById('modal-customer-name').textContent = booking.userId?.name || 'N/A';
                        document.getElementById('modal-customer-email').textContent = booking.userId?.email || 'N/A';
                        document.getElementById('modal-customer-phone').textContent = booking.userId?.phone || 'N/A';
                        document.getElementById('modal-contact-number').textContent = booking.contactNumber || 'N/A';

                        // Vendor info
                        document.getElementById('modal-vendor-name').textContent = booking.vendorId?.fullName || booking.vendorId?.companyName || 'N/A';
                        document.getElementById('modal-vendor-email').textContent = booking.vendorId?.email || 'N/A';
                        document.getElementById('modal-vendor-phone').textContent = booking.vendorId?.phone || 'N/A';

                        // Car info
                        const carModel = `${booking.carId?.brand?.name || 'N/A'} ${booking.carId?.model || 'N/A'}`;
                        document.getElementById('modal-car-model').textContent = carModel;
                        document.getElementById('modal-car-reg').textContent = booking.carId?.registrationNumber || 'N/A';

                        const carImage = document.getElementById('modal-car-image');
                        if (booking.carId?.images && booking.carId.images.length > 0) {
                            carImage.src = booking.carId.images[0];
                            carImage.style.display = 'block';
                        } else {
                            carImage.style.display = 'none';
                        }

                        // Booking info
                        const bookingDate = new Date(booking.bookingDate).toLocaleDateString('en-IN', {
                            day: '2-digit',
                            month: 'long',
                            year: 'numeric'
                        });
                        document.getElementById('modal-booking-date').textContent = bookingDate;
                        document.getElementById('modal-time-slot').textContent = `${booking.startTime} - ${booking.endTime}`;
                        document.getElementById('modal-amount').textContent = `₹${(booking.amount || 0).toLocaleString('en-IN')}`;

                        // Additional info
                        document.getElementById('modal-pickup-location').textContent = booking.pickupLocation || 'N/A';

                        // Status badges
                        let statusClass = 'badge-pending';
                        if (booking.status === 'confirmed') statusClass = 'badge-confirmed';
                        if (booking.status === 'completed') statusClass = 'badge-completed';
                        if (booking.status === 'cancelled') statusClass = 'badge-cancelled';
                        document.getElementById('modal-status').innerHTML = `<span class="status-badge ${statusClass}">${booking.status}</span>`;

                        let paymentClass = 'badge-payment-pending';
                        if (booking.paymentStatus === 'paid') paymentClass = 'badge-paid';
                        if (booking.paymentStatus === 'refunded') paymentClass = 'badge-refunded';
                        document.getElementById('modal-payment-status').innerHTML = `<span class="status-badge ${paymentClass}">${booking.paymentStatus}</span>`;

                        // Special requests
                        document.getElementById('modal-special-requests').textContent = booking.specialRequests || 'None';

                        // Timestamps
                        document.getElementById('modal-created-at').textContent = new Date(booking.createdAt).toLocaleString('en-IN');
                        document.getElementById('modal-updated-at').textContent = new Date(booking.updatedAt).toLocaleString('en-IN');

                        // Show modal
                        const modal = new bootstrap.Modal(document.getElementById('bookingDetailsModal'));
                        modal.show();
                    });
                });
            });
        </script>