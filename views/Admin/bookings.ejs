<%- include("../partials/admin/header.ejs") %>

    <style>
        /* Enhanced Admin Bookings Styles */
        .stats-card {
            border-radius: 16px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: none;
        }

        .stats-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
        }

        .stats-icon {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
        }

        .booking-card {
            border-radius: 16px;
            border: none;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .booking-card-header {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            color: white;
            padding: 1.5rem;
            border: none;
        }

        .filter-section {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
        }

        .custom-select {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            padding: 0.6rem 1rem;
            transition: all 0.3s ease;
        }

        .custom-select:focus {
            border-color: #2c3e50;
            box-shadow: 0 0 0 3px rgba(44, 62, 80, 0.1);
            outline: none;
        }

        .booking-table {
            font-size: 0.9rem;
        }

        .booking-table thead th {
            background: #f8f9fa;
            border: none;
            color: #6c757d;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            padding: 1rem 0.75rem;
        }

        .booking-table tbody td {
            padding: 1rem 0.75rem;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
        }

        .booking-table tbody tr {
            transition: background-color 0.2s ease;
        }

        .booking-table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .booking-id {
            font-family: 'Courier New', monospace;
            font-size: 0.8rem;
            color: #6c757d;
            font-weight: 600;
        }

        .customer-info {
            display: flex;
            flex-direction: column;
        }

        .customer-name {
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 0.25rem;
        }

        .customer-email {
            font-size: 0.8rem;
            color: #718096;
        }

        .car-thumbnail {
            width: 60px;
            height: 45px;
            border-radius: 8px;
            object-fit: cover;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .car-placeholder {
            width: 60px;
            height: 45px;
            border-radius: 8px;
            background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .car-details {
            display: flex;
            flex-direction: column;
        }

        .car-model {
            font-weight: 600;
            color: #2d3748;
            font-size: 0.85rem;
            margin-bottom: 0.25rem;
        }

        .car-reg {
            font-size: 0.75rem;
            color: #718096;
            font-family: 'Courier New', monospace;
        }

        .vendor-info {
            display: flex;
            flex-direction: column;
        }

        .vendor-name {
            font-weight: 500;
            color: #2d3748;
            font-size: 0.85rem;
            margin-bottom: 0.25rem;
        }

        .vendor-phone {
            font-size: 0.75rem;
            color: #718096;
        }

        .booking-date {
            font-weight: 600;
            color: #2d3748;
            font-size: 0.85rem;
            margin-bottom: 0.25rem;
        }

        .booking-time {
            font-size: 0.75rem;
            color: #718096;
        }

        .amount-display {
            font-weight: 700;
            color: #10b981;
            font-size: 1rem;
        }

        .status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: capitalize;
            display: inline-block;
        }

        .badge-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-confirmed {
            background: #dbeafe;
            color: #1e40af;
        }

        .badge-completed {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-cancelled {
            background: #fee2e2;
            color: #991b1b;
        }

        .badge-paid {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-payment-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-refunded {
            background: #dbeafe;
            color: #1e40af;
        }

        .view-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            background: white;
            color: #2c3e50;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .view-btn:hover {
            background: #2c3e50;
            color: white;
            border-color: #2c3e50;
            transform: scale(1.1);
        }

        .filter-btn {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            border: none;
            border-radius: 8px;
            padding: 0.6rem 1.5rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .filter-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(44, 62, 80, 0.4);
        }

        .pagination .page-link {
            border-radius: 8px;
            margin: 0 0.25rem;
            border: 1px solid #e0e0e0;
            color: #2c3e50;
            font-weight: 500;
        }

        .pagination .page-item.active .page-link {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            border-color: #2c3e50;
        }

        .pagination .page-link:hover {
            background: #f8f9fa;
            border-color: #2c3e50;
        }

        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
        }

        .empty-state-icon {
            font-size: 4rem;
            color: #cbd5e0;
            margin-bottom: 1rem;
        }

        .empty-state-text {
            color: #718096;
            font-size: 1.1rem;
        }

        .modal-header-custom {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            color: white;
            border: none;
            padding: 1.5rem;
        }

        .modal-content {
            border-radius: 16px;
            border: none;
            overflow: hidden;
        }

        .modal-section-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: #2c3e50;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
        }

        .modal-section-title i {
            margin-right: 0.5rem;
        }

        .modal-info-label {
            font-size: 0.75rem;
            color: #718096;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.25rem;
        }

        .modal-info-value {
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 1rem;
        }

        .modal-divider {
            border-top: 2px solid #f0f0f0;
            margin: 1.5rem 0;
        }

        @media (max-width: 768px) {
            .stats-card {
                margin-bottom: 1rem;
            }

            .booking-table {
                font-size: 0.8rem;
            }

            .car-thumbnail,
            .car-placeholder {
                width: 50px;
                height: 38px;
            }
        }
    </style>

    <div class="container-fluid py-4">
        <div class="row">
            <main role="main" class="col-12 px-4">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb bg-transparent p-0">
                        <li class="breadcrumb-item"><a href="/admin" class="text-decoration-none">Dashboard</a></li>
                        <li class="breadcrumb-item active">Bookings</li>
                    </ol>
                </nav>

                <!-- Page Title -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1 fw-bold">Bookings Management</h2>
                        <p class="text-muted mb-0">Monitor and manage all test drive bookings</p>
                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="stats-card card h-100 shadow-sm"
                            style="background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center">
                                    <div class="stats-icon me-3">
                                        <i class="fas fa-calendar-check fa-lg text-white"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <p class="text-white-50 mb-1 small fw-semibold">Total Bookings</p>
                                        <h3 class="text-white mb-0 fw-bold">
                                            <%= totalCount %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="stats-card card h-100 shadow-sm"
                            style="background: linear-gradient(135deg, #e67e22 0%, #d35400 100%);">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center">
                                    <div class="stats-icon me-3">
                                        <i class="fas fa-clock fa-lg text-white"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <p class="text-white-50 mb-1 small fw-semibold">Pending</p>
                                        <h3 class="text-white mb-0 fw-bold">
                                            <%= pendingCount %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="stats-card card h-100 shadow-sm"
                            style="background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center">
                                    <div class="stats-icon me-3">
                                        <i class="fas fa-check-circle fa-lg text-white"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <p class="text-white-50 mb-1 small fw-semibold">Confirmed</p>
                                        <h3 class="text-white mb-0 fw-bold">
                                            <%= confirmedCount %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="stats-card card h-100 shadow-sm"
                            style="background: linear-gradient(135deg, #27ae60 0%, #229954 100%);">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center">
                                    <div class="stats-icon me-3">
                                        <i class="fas fa-rupee-sign fa-lg text-white"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <p class="text-white-50 mb-1 small fw-semibold">Total Revenue</p>
                                        <h3 class="text-white mb-0 fw-bold">₹<%=totalRevenue.toLocaleString('en-IN') %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Bookings Card -->
                <div class="booking-card">
                    <!-- Card Header -->
                    <div class="booking-card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1 fw-bold">All Bookings</h5>
                                <small class="opacity-75">Showing <%= bookings.length %> of <%= totalCount %> bookings
                                </small>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="fas fa-list-ul fa-lg"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Filter Section -->
                    <div class="p-4">
                        <div class="filter-section">
                            <form method="GET" action="/admin/bookings">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-4">
                                        <label class="modal-info-label mb-2">Booking Status</label>
                                        <select name="status" class="form-select custom-select">
                                            <option value="all" <%=status==='all' ? 'selected' : '' %>>All Status
                                            </option>
                                            <option value="pending" <%=status==='pending' ? 'selected' : '' %>>Pending
                                            </option>
                                            <option value="confirmed" <%=status==='confirmed' ? 'selected' : '' %>>
                                                Confirmed</option>
                                            <option value="completed" <%=status==='completed' ? 'selected' : '' %>>
                                                Completed</option>
                                            <option value="cancelled" <%=status==='cancelled' ? 'selected' : '' %>>
                                                Cancelled</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="modal-info-label mb-2">Payment Status</label>
                                        <select name="paymentStatus" class="form-select custom-select">
                                            <option value="all" <%=paymentStatus==='all' ? 'selected' : '' %>>All
                                                Payments</option>
                                            <option value="pending" <%=paymentStatus==='pending' ? 'selected' : '' %>>
                                                Pending</option>
                                            <option value="paid" <%=paymentStatus==='paid' ? 'selected' : '' %>>Paid
                                            </option>
                                            <option value="refunded" <%=paymentStatus==='refunded' ? 'selected' : '' %>>
                                                Refunded</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-primary filter-btn w-100">
                                            <i class="fas fa-filter me-2"></i>Apply Filters
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- Table -->
                        <div class="table-responsive">
                            <table class="table booking-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Booking ID</th>
                                        <th>Customer</th>
                                        <th>Car Details</th>
                                        <th>Vendor</th>
                                        <th>Date & Time</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Payment</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% if (bookings.length===0) { %>
                                        <tr>
                                            <td colspan="9">
                                                <div class="empty-state">
                                                    <i class="fas fa-inbox empty-state-icon"></i>
                                                    <p class="empty-state-text mb-0">No bookings found</p>
                                                    <small class="text-muted">Try adjusting your filters</small>
                                                </div>
                                            </td>
                                        </tr>
                                        <% } %>

                                            <% bookings.forEach(booking=> { %>
                                                <tr>
                                                    <td>
                                                        <span class="booking-id">#<%=
                                                                booking._id.toString().slice(-8).toUpperCase() %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="customer-info">
                                                            <div class="customer-name">
                                                                <%= booking.userId?.name || 'N/A' %>
                                                            </div>
                                                            <div class="customer-email">
                                                                <%= booking.userId?.email || 'N/A' %>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-3">
                                                            <% if (booking.carId?.images && booking.carId.images.length>
                                                                0) { %>
                                                                <img src="<%= booking.carId.images[0] %>" alt="Car"
                                                                    class="car-thumbnail">
                                                                <% } else { %>
                                                                    <div class="car-placeholder">
                                                                        <i class="fas fa-car text-muted"></i>
                                                                    </div>
                                                                    <% } %>
                                                                        <div class="car-details">
                                                                            <div class="car-model">
                                                                                <%= booking.carId?.brand?.name || 'N/A'
                                                                                    %>
                                                                                    <%= booking.carId?.model || 'N/A' %>
                                                                            </div>
                                                                            <div class="car-reg">
                                                                                <%= booking.carId?.registrationNumber
                                                                                    || 'N/A' %>
                                                                            </div>
                                                                        </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="vendor-info">
                                                            <div class="vendor-name">
                                                                <%= booking.vendorId?.fullName ||
                                                                    booking.vendorId?.companyName || 'N/A' %>
                                                            </div>
                                                            <div class="vendor-phone">
                                                                <%= booking.vendorId?.phone || 'N/A' %>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div>
                                                            <div class="booking-date">
                                                                <%= new
                                                                    Date(booking.bookingDate).toLocaleDateString('en-IN',
                                                                    { day: '2-digit' , month: 'short' , year: 'numeric'
                                                                    }) %>
                                                            </div>
                                                            <div class="booking-time">
                                                                <%= booking.startTime %> - <%= booking.endTime %>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="amount-display">₹<%= booking.amount ?
                                                                booking.amount.toLocaleString('en-IN') : '0' %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <% let statusClass='badge-pending' ; if
                                                            (booking.status==='confirmed' )
                                                            statusClass='badge-confirmed' ; if
                                                            (booking.status==='completed' )
                                                            statusClass='badge-completed' ; if
                                                            (booking.status==='cancelled' )
                                                            statusClass='badge-cancelled' ; %>
                                                            <span class="status-badge <%= statusClass %>">
                                                                <%= booking.status %>
                                                            </span>
                                                    </td>
                                                    <td>
                                                        <% let paymentClass='badge-payment-pending' ; if
                                                            (booking.paymentStatus==='paid' ) paymentClass='badge-paid'
                                                            ; if (booking.paymentStatus==='refunded' )
                                                            paymentClass='badge-refunded' ; %>
                                                            <span class="status-badge <%= paymentClass %>">
                                                                <%= booking.paymentStatus %>
                                                            </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <button class="view-btn view-details-btn"
                                                            data-booking='<%= JSON.stringify(booking) %>'>
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages> 1) { %>
                            <div class="mt-4">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center mb-0">
                                        <% if (hasPrevPage) { %>
                                            <li class="page-item">
                                                <a class="page-link"
                                                    href="?page=<%= currentPage - 1 %>&status=<%= status %>&paymentStatus=<%= paymentStatus %>"
                                                    aria-label="Previous">
                                                    <i class="fas fa-chevron-left"></i>
                                                </a>
                                            </li>
                                            <% } %>

                                                <% for(let i=1; i <=totalPages; i++) { %>
                                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                        <a class="page-link"
                                                            href="?page=<%= i %>&status=<%= status %>&paymentStatus=<%= paymentStatus %>">
                                                            <%= i %>
                                                        </a>
                                                    </li>
                                                    <% } %>

                                                        <% if (hasNextPage) { %>
                                                            <li class="page-item">
                                                                <a class="page-link"
                                                                    href="?page=<%= currentPage + 1 %>&status=<%= status %>&paymentStatus=<%= paymentStatus %>"
                                                                    aria-label="Next">
                                                                    <i class="fas fa-chevron-right"></i>
                                                                </a>
                                                            </li>
                                                            <% } %>
                                    </ul>
                                </nav>
                            </div>
                            <% } %>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Enhanced Booking Details Modal -->
    <div class="modal fade" id="bookingDetailsModal" tabindex="-1" aria-labelledby="bookingDetailsModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header modal-header-custom">
                    <h5 class="modal-title fw-bold" id="bookingDetailsModalLabel">
                        <i class="fas fa-file-invoice me-2"></i>Booking Details
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Customer Information -->
                    <div class="mb-4">
                        <h6 class="modal-section-title">
                            <i class="fas fa-user"></i>Customer Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="modal-info-label">Name</div>
                                <div class="modal-info-value" id="modal-customer-name"></div>
                            </div>
                            <div class="col-md-6">
                                <div class="modal-info-label">Email</div>
                                <div class="modal-info-value" id="modal-customer-email"></div>
                            </div>
                            <div class="col-md-6">
                                <div class="modal-info-label">Phone</div>
                                <div class="modal-info-value" id="modal-customer-phone"></div>
                            </div>
                            <div class="col-md-6">
                                <div class="modal-info-label">Contact Number</div>
                                <div class="modal-info-value" id="modal-contact-number"></div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-divider"></div>

                    <!-- Vendor Information -->
                    <div class="mb-4">
                        <h6 class="modal-section-title">
                            <i class="fas fa-store"></i>Vendor Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="modal-info-label">Name</div>
                                <div class="modal-info-value" id="modal-vendor-name"></div>
                            </div>
                            <div class="col-md-4">
                                <div class="modal-info-label">Email</div>
                                <div class="modal-info-value" id="modal-vendor-email"></div>
                            </div>
                            <div class="col-md-4">
                                <div class="modal-info-label">Phone</div>
                                <div class="modal-info-value" id="modal-vendor-phone"></div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-divider"></div>

                    <!-- Car Information -->
                    <div class="mb-4">
                        <h6 class="modal-section-title">
                            <i class="fas fa-car"></i>Car Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="modal-info-label">Car Model</div>
                                        <div class="modal-info-value" id="modal-car-model"></div>
                                    </div>
                                    <div class="col-12">
