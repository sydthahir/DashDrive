<%- include("../partials/admin/header.ejs") %>

    <div class="container-fluid py-4">
        <div class="row">
            <main role="main" class="col-12 px-4">
                <!-- Breadcrumb -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="/admin"
                                    class="text-decoration-none text-secondary">Dashboard</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Brands</li>
                        </ol>
                    </nav>
                    <button class="btn btn-primary shadow-sm" onclick="openAddModal()">
                        <i class="fas fa-plus me-2"></i>Add New Brand
                    </button>
                </div>

                <!-- Content Card -->
                <div class="card border-0 rounded-3 shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom-0">
                        <div class="row align-items-center g-3">
                            <div class="col-12 col-md-6">
                                <h5 class="mb-0 fw-bold text-dark">Car Brands Management</h5>
                                <p class="text-muted small mb-0">Manage vehicle brands available in the system</p>
                            </div>
                            <div class="col-12 col-md-6">
                                <form method="GET" action="/admin/brands" class="d-flex justify-content-md-end">
                                    <div class="input-group" style="max-width: 300px;">
                                        <span class="input-group-text bg-light border-end-0 text-secondary">
                                            <i class="fas fa-search"></i>
                                        </span>
                                        <input type="text" name="search"
                                            value="<%= typeof search !== 'undefined' ? search : '' %>"
                                            class="form-control bg-light border-start-0" placeholder="Search brands..."
                                            aria-label="Search">
                                        <button class="btn btn-primary" type="submit">Search</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4 py-3 text-secondary text-uppercase text-xs fw-bolder opacity-7">
                                            Brand Details</th>
                                        <th class="py-3 text-secondary text-uppercase text-xs fw-bolder opacity-7">
                                            Status</th>
                                        <th class="py-3 text-secondary text-uppercase text-xs fw-bolder opacity-7">
                                            Created Date</th>
                                        <th
                                            class="py-3 text-end pe-4 text-secondary text-uppercase text-xs fw-bolder opacity-7">
                                            Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof brands !=='undefined' && brands.length> 0) { %>
                                        <% brands.forEach(brand=> { %>
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-3 rounded d-flex align-items-center justify-content-center bg-light shadow-sm"
                                                            style="width: 48px; height: 48px; overflow: hidden;">
                                                            <% if (brand.logo) { %>
                                                                <img src="<%= brand.logo %>" alt="<%= brand.name %>"
                                                                    class="w-100 h-100" style="object-fit: cover;">
                                                                <% } else { %>
                                                                    <i class="fas fa-car text-secondary"></i>
                                                                    <% } %>
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0 fw-bold text-dark">
                                                                <%= brand.name %>
                                                            </h6>
                                                            <div class="small text-muted">ID: <%=
                                                                    brand._id.toString().substring(brand._id.toString().length
                                                                    - 6).toUpperCase() %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <% if (brand.isActive) { %>
                                                        <span
                                                            class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Active</span>
                                                        <% } else { %>
                                                            <span
                                                                class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Inactive</span>
                                                            <% } %>
                                                </td>
                                                <td>
                                                    <span class="text-secondary text-sm font-weight-bold">
                                                        <%= new Date(brand.createdAt).toLocaleDateString('en-IN', {
                                                            day: 'numeric' , month: 'short' , year: 'numeric' }) %>
                                                    </span>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <button class="btn btn-sm btn-light text-primary shadow-sm me-2"
                                                        onclick="editBrand(this)"
                                                        data-brand='<%= JSON.stringify(brand).replace(/' /g, "&#39;" )
                                                        %>' title="Edit Brand">
                                                        <i class="fas fa-edit"></i>
                                                    </button>

                                                    <% if (brand.isActive) { %>
                                                        <button class="btn btn-sm btn-light text-danger shadow-sm"
                                                            onclick="toggleStatus('<%= brand._id %>', 'block')"
                                                            title="Deactivate">
                                                            <i class="fas fa-ban"></i>
                                                        </button>
                                                        <% } else { %>
                                                            <button class="btn btn-sm btn-light text-success shadow-sm"
                                                                onclick="toggleStatus('<%= brand._id %>', 'unblock')"
                                                                title="Activate">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                            <% } %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="4" class="text-center py-5">
                                                            <div class="d-flex flex-column align-items-center">
                                                                <div class="bg-light rounded-circle p-4 mb-3">
                                                                    <i
                                                                        class="fas fa-car-crash text-secondary fa-2x"></i>
                                                                </div>
                                                                <h6 class="text-secondary fw-bold">No Brands Found</h6>
                                                                <p class="text-muted small">Get started by adding a new
                                                                    car brand.</p>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                            <div class="card-footer bg-white py-3 border-top-0">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center mb-0">
                                        <% if (hasPrevPage) { %>
                                            <li class="page-item">
                                                <a class="page-link border-0 shadow-sm mx-1 rounded-circle d-flex align-items-center justify-content-center"
                                                    href="?page=<%= currentPage - 1 %>&search=<%= typeof search !== 'undefined' ? search : '' %>"
                                                    style="width: 32px; height: 32px;">
                                                    <i class="fas fa-chevron-left text-xs"></i>
                                                </a>
                                            </li>
                                            <% } %>

                                                <% for(let i=1; i <=totalPages; i++) { %>
                                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                        <a class="page-link border-0 shadow-sm mx-1 rounded-circle d-flex align-items-center justify-content-center"
                                                            href="?page=<%= i %>&search=<%= typeof search !== 'undefined' ? search : '' %>"
                                                            style="width: 32px; height: 32px;">
                                                            <%= i %>
                                                        </a>
                                                    </li>
                                                    <% } %>

                                                        <% if (hasNextPage) { %>
                                                            <li class="page-item">
                                                                <a class="page-link border-0 shadow-sm mx-1 rounded-circle d-flex align-items-center justify-content-center"
                                                                    href="?page=<%= currentPage + 1 %>&search=<%= typeof search !== 'undefined' ? search : '' %>"
                                                                    style="width: 32px; height: 32px;">
                                                                    <i class="fas fa-chevron-right text-xs"></i>
                                                                </a>
                                                            </li>
                                                            <% } %>
                                    </ul>
                                </nav>
                            </div>
                            <% } %>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Add/Edit Modal -->
    <div class="modal fade" id="brandModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold" id="brandModalLabel">Add New Brand</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 pt-4 pb-4">
                    <form id="brandForm">
                        <input type="hidden" id="brandId" name="id">

                        <div class="mb-4">
                            <label for="brandName"
                                class="form-label text-secondary text-xs fw-bold text-uppercase ls-1">Brand Name</label>
                            <input type="text"
                                class="form-control form-control-lg bg-light border-0 shadow-none focus-ring"
                                id="brandName" name="name" placeholder="E.g. Tesla, BMW" required>
                        </div>

                        <div class="mb-4">
                            <label for="brandLogo"
                                class="form-label text-secondary text-xs fw-bold text-uppercase ls-1">Brand Logo
                                (Optional)</label>
                            <input type="file" class="form-control form-control-lg bg-light border-0" id="brandLogo"
                                name="logo" accept="image/*">
                            <div class="form-text text-xs mt-2">
                                <i class="fas fa-info-circle me-1"></i> Max 2MB. Supported formats: JPG, PNG, WEBP.
                            </div>
                            <!-- Preview container -->
                            <div id="imagePreview" class="mt-3 d-none">
                                <img src="" class="rounded shadow-sm" style="height: 60px; width: auto;">
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold">
                                <span id="submitBtnText">Save Brand</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <%- include("../partials/admin/footer.ejs") %>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
            const brandModal = new bootstrap.Modal(document.getElementById('brandModal'));
            const brandForm = document.getElementById('brandForm');

            // Open Modal for Create
            function openAddModal() {
                document.getElementById('brandModalLabel').textContent = 'Add New Brand';
                document.getElementById('submitBtnText').textContent = 'Save Brand';
                document.getElementById('brandId').value = '';
                document.getElementById('imagePreview').classList.add('d-none');
                brandForm.reset();
                brandModal.show();
            }

            // Open Modal for Edit
            function editBrand(btn) {
                const brand = JSON.parse(btn.dataset.brand);

                document.getElementById('brandModalLabel').textContent = 'Edit Brand';
                document.getElementById('submitBtnText').textContent = 'Update Brand';
                document.getElementById('brandId').value = brand._id;
                document.getElementById('brandName').value = brand.name;

                if (brand.logo) {
                    const preview = document.getElementById('imagePreview');
                    preview.classList.remove('d-none');
                    preview.querySelector('img').src = brand.logo;
                } else {
                    document.getElementById('imagePreview').classList.add('d-none');
                }

                brandModal.show();
            }

            // Handle Form Submit
            brandForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                const id = document.getElementById('brandId').value;
                const isEdit = !!id;

                
                const formData = new FormData(brandForm);

                // Show Loading
                const submitBtn = brandForm.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...';

                try {
                    const url = isEdit ? '/admin/brands/edit' : '/admin/brands/add';
                    const method = isEdit ? 'PUT' : 'POST';

                 
                    const res = await fetch(url, {
                        method: method,
                        body: formData
                    });

                    const data = await res.json();

                    if (data.success) {
                        brandModal.hide();
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: data.message,
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        throw new Error(data.message || 'Something went wrong');
                    }

                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message
                    });
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            });

            // Toggle Status
            async function toggleStatus(id, action) {
                const result = await Swal.fire({
                    title: 'Are you sure?',
                    text: `Do you want to ${action === 'block' ? 'deactivate' : 'activate'} this brand?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: action === 'block' ? '#dc3545' : '#198754',
                    confirmButtonText: action === 'block' ? 'Yes, Deactivate' : 'Yes, Activate'
                });

                if (result.isConfirmed) {
                    try {
                        const res = await fetch('/admin/brands/toggle-status', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id, action })
                        });

                        const data = await res.json();

                        if (data.success) {
                            Swal.fire(
                                'Updated!',
                                data.message,
                                'success'
                            ).then(() => location.reload());
                        } else {
                            throw new Error(data.message);
                        }
                    } catch (error) {
                        Swal.fire(
                            'Error!',
                            error.message || 'Failed to update status',
                            'error'
                        );
                    }
                }
            }

            // Image Preview
            document.getElementById('brandLogo').addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const preview = document.getElementById('imagePreview');
                        preview.classList.remove('d-none');
                        preview.querySelector('img').src = e.target.result;
                    }
                    reader.readAsDataURL(file);
                }
            });

        </script>