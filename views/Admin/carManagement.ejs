<%- include("../partials/admin/header.ejs") %>

    <link rel="stylesheet" href="/css/admin-carManagement.css">
    <link rel="stylesheet" href="/css/global-fonts.css">
    <link rel="stylesheet" href="/css/admin/admin-carManagement.css">
    <div class="container-fluid py-4">
        <div class="row">
            <main role="main" class="col-12 px-4">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-4">
                        <li class="breadcrumb-item active">Dashboard > Car Management</li>
                    </ol>
                </nav>

                <!-- Page Title -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0 page-title">Car Management</h4>
                </div>

                <!-- Stats Cards -->
                <div class="row g-4 mb-4">
                    <div class="col-12 col-md-3">
                        <div class="stats-card pending-card">
                            <div class="card-body d-flex align-items-center py-4">
                                <div class="d-flex align-items-center w-100">
                                    <div class="icon-wrapper pending-icon">
                                        <i class="fas fa-clock"></i>
                                    </div>
                                    <div>
                                        <h6 class="stat-label">Pending</h6>
                                        <h3 class="stat-value">
                                            <%= pendingCount %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="stats-card approved-card">
                            <div class="card-body d-flex align-items-center py-4">
                                <div class="d-flex align-items-center w-100">
                                    <div class="icon-wrapper approved-icon">
                                        <i class="fas fa-check-circle"></i>
                                    </div>
                                    <div>
                                        <h6 class="stat-label">Approved</h6>
                                        <h3 class="stat-value">
                                            <%= approvedCount %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="stats-card rejected-card">
                            <div class="card-body d-flex align-items-center py-4">
                                <div class="d-flex align-items-center w-100">
                                    <div class="icon-wrapper rejected-icon">
                                        <i class="fas fa-times-circle"></i>
                                    </div>
                                    <div>
                                        <h6 class="stat-label">Rejected</h6>
                                        <h3 class="stat-value">
                                            <%= rejectedCount %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="stats-card total-card">
                            <div class="card-body d-flex align-items-center py-4">
                                <div class="d-flex align-items-center w-100">
                                    <div class="icon-wrapper total-icon">
                                        <i class="fas fa-car"></i>
                                    </div>
                                    <div>
                                        <h6 class="stat-label">Total Cars</h6>
                                        <h3 class="stat-value">
                                            <%= totalCount %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filters and Search -->
                <div class="card border-0 rounded-3 shadow-sm mb-4">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <form method="GET" action="/admin/cars-management" class="search-form">
                                    <input type="hidden" name="status" value="<%= status %>">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0">
                                            <i class="fas fa-search text-muted"></i>
                                        </span>
                                        <input type="text" name="search" value="<%= search || '' %>"
                                            class="form-control border-start-0"
                                            placeholder="Search by model or registration number...">
                                        <button class="btn btn-primary" type="submit">Search</button>
                                    </div>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <div class="status-filters">
                                    <a href="?status=pending<%= search ? '&search=' + search : '' %>"
                                        class="filter-btn <%= status === 'pending' ? 'active' : '' %>">
                                        <i class="fas fa-clock"></i> Pending
                                    </a>
                                    <a href="?status=approved<%= search ? '&search=' + search : '' %>"
                                        class="filter-btn <%= status === 'approved' ? 'active' : '' %>">
                                        <i class="fas fa-check-circle"></i> Approved
                                    </a>
                                    <a href="?status=rejected<%= search ? '&search=' + search : '' %>"
                                        class="filter-btn <%= status === 'rejected' ? 'active' : '' %>">
                                        <i class="fas fa-times-circle"></i> Rejected
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cars Table -->
                <div class="card border-0 rounded-3 shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table car-table mb-0">
                                <thead>
                                    <tr>
                                        <th class="px-4 py-3">#</th>
                                        <th class="px-4 py-3">Car</th>
                                        <th class="px-4 py-3">Brand</th>
                                        <th class="px-4 py-3">Vendor</th>
                                        <th class="px-4 py-3">Registration</th>
                                        <th class="px-4 py-3 d-none d-md-table-cell">Fuel Type</th>
                                        <th class="px-4 py-3 d-none d-lg-table-cell">Transmission</th>
                                        <th class="px-4 py-3">Price/Slot</th>
                                        <th class="px-4 py-3">Status</th>
                                        <th class="px-4 py-3">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (cars && cars.length> 0) { %>
                                        <% cars.forEach((car, index)=> { %>
                                            <tr class="car-row">
                                                <td class="px-4 py-3">
                                                    <%= (currentPage - 1) * 10 + index + 1 %>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <div class="car-info">
                                                        <div class="car-image">
                                                            <% if (car.images && car.images.length> 0) { %>
                                                                <img src="<%= car.images[0] %>" alt="<%= car.model %>">
                                                                <% } else { %>
                                                                    <div class="no-image">
                                                                        <i class="fas fa-car"></i>
                                                                    </div>
                                                                    <% } %>
                                                        </div>
                                                        <div class="car-details">
                                                            <div class="car-name">
                                                                <%= car.model %>
                                                            </div>
                                                            <div class="car-year">
                                                                <%= car.year %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <div class="brand-info">
                                                        <% if (car.brand && car.brand.logo) { %>
                                                            <img src="<%= car.brand.logo %>" alt="<%= car.brand.name %>"
                                                                class="brand-logo">
                                                            <% } %>
                                                                <span>
                                                                    <%= car.brand ? car.brand.name : 'N/A' %>
                                                                </span>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <a href="/admin/vendors/details/<%= car.vendorId._id %>"
                                                        class="vendor-link">
                                                        <%= car.vendorId ? car.vendorId.fullName : 'N/A' %>
                                                    </a>
                                                    <div class="vendor-company">
                                                        <%= car.vendorId ? car.vendorId.companyName : '' %>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <span class="registration-number">
                                                        <%= car.registrationNumber %>
                                                    </span>
                                                </td>
                                                <td class="px-4 py-3 d-none d-md-table-cell">
                                                    <span class="fuel-badge <%= car.fuelType.toLowerCase() %>">
                                                        <%= car.fuelType %>
                                                    </span>
                                                </td>
                                                <td class="px-4 py-3 d-none d-lg-table-cell">
                                                    <%= car.carType %>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <span class="price">₹<%= car.chargePerSlot %></span>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <% if (car.status==='pending' ) { %>
                                                        <span class="status-badge pending">
                                                            <i class="fas fa-clock"></i> Pending
                                                        </span>
                                                        <% } else if (car.status==='approved' ) { %>
                                                            <span class="status-badge approved">
                                                                <i class="fas fa-check-circle"></i> Approved
                                                            </span>
                                                            <% } else if (car.status==='rejected' ) { %>
                                                                <span class="status-badge rejected">
                                                                    <i class="fas fa-times-circle"></i> Rejected
                                                                </span>
                                                                <% } %>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <div class="action-buttons">
                                                        <a href="/admin/cars/details/<%= car._id %>"
                                                            class="action-btn view-btn">
                                                            <i class="fas fa-eye"></i>
                                                        </a>

                                                        <% if (car.status==='pending' ) { %>
                                                            <button class="action-btn approve-btn"
                                                                data-car-id="<%= car._id %>" title="Approve">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                            <button class="action-btn reject-btn"
                                                                data-car-id="<%= car._id %>" title="Reject">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                            <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="10" class="text-center py-5">
                                                            <div class="empty-state">
                                                                <i class="fas fa-car fa-3x mb-3"></i>
                                                                <p class="mb-0">No cars found</p>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages> 1) { %>
                            <div class="card-footer bg-white py-3">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center mb-0">
                                        <% if (hasPrevPage) { %>
                                            <li class="page-item">
                                                <a class="page-link"
                                                    href="?page=<%= currentPage - 1 %>&status=<%= status %><%= search ? '&search=' + search : '' %>"
                                                    aria-label="Previous">
                                                    <span aria-hidden="true">«</span>
                                                </a>
                                            </li>
                                            <% } %>
                                                <% for(let i=1; i <=totalPages; i++) { %>
                                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                        <a class="page-link"
                                                            href="?page=<%= i %>&status=<%= status %><%= search ? '&search=' + search : '' %>">
                                                            <%= i %>
                                                        </a>
                                                    </li>
                                                    <% } %>
                                                        <% if (hasNextPage) { %>
                                                            <li class="page-item">
                                                                <a class="page-link"
                                                                    href="?page=<%= currentPage + 1 %>&status=<%= status %><%= search ? '&search=' + search : '' %>"
                                                                    aria-label="Next">
                                                                    <span aria-hidden="true">»</span>
                                                                </a>
                                                            </li>
                                                            <% } %>
                                    </ul>
                                </nav>
                            </div>
                            <% } %>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Car Details Modal -->
    <div class="modal fade" id="carDetailsModal" tabindex="-1" aria-labelledby="carDetailsModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="carDetailsModalLabel">Car Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="carDetailsContent">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/admin-carManagement.js"></script>

    <%- include("../partials/admin/footer.ejs") %>