<%- include("../partials/admin/header.ejs") %>

    <div class="container-fluid py-4">
        <div class="row">
            <main role="main" class="col-12 px-4">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-4">
                        <li class="breadcrumb-item active">Dashboard > Users </li>
                    </ol>
                </nav>

                <!-- Stats Cards -->
                <div class="row g-4 mb-4">
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border-0 rounded-3" style="background-color: #0d6efd;">
                            <div class="card-body d-flex align-items-center py-4">
                                <div class="d-flex align-items-center w-100">
                                    <i class="fas fa-users fa-2x text-white me-4"></i>
                                    <div>
                                        <h6 class="text-white mb-2 fs-sm">Total Users</h6>
                                        <h3 class="text-white mb-0 fs-2">
                                            <%= totalUsers %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border-0 rounded-3" style="background-color: #198754;">
                            <div class="card-body d-flex align-items-center py-4">
                                <div class="d-flex align-items-center w-100">
                                    <i class="fas fa-user-check fa-2x text-white me-4"></i>
                                    <div>
                                        <h6 class="text-white mb-2 fs-sm">Active Users</h6>
                                        <h3 class="text-white mb-0 fs-2">
                                            <%= activeUsers %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border-0 rounded-3" style="background-color: #0dcaf0;">
                            <div class="card-body d-flex align-items-center py-4">
                                <div class="d-flex align-items-center w-100">
                                    <i class="fas fa-user-plus fa-2x text-white me-4"></i>
                                    <div>
                                        <h6 class="text-white mb-2 fs-sm">New Users (This Month)</h6>
                                        <h3 class="text-white mb-0 fs-2">
                                            <%= newUsers %>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Users Table -->
                <div class="card border-0 rounded-3 shadow-sm">
                    <div class="card-header bg-white">
                        <form method="GET" action="/admin/users">
                            <div class="input-group input-group-sm w-50 mx-auto">
                                <input type="text" name="search" value="<%= search || '' %>" class="form-control"
                                    placeholder="Search users...">
                                <button class="btn btn-outline-primary">Search</button>
                            </div>
                        </form>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Join Date</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% if (users.length===0) { %>

                                        <tr>
                                            <td colspan="5" class="text-center py-4">
                                                No users found
                                            </td>
                                        </tr>
                                        <% } %>

                                            <% users.forEach(user=> { %>
                                                <tr>
                                                    <td>
                                                        <%= user.name %>
                                                    </td>
                                                    <td>
                                                        <%= user.email %>
                                                    </td>
                                                    <td>
                                                        <%= new Date(user.createdAt).toLocaleDateString('en-IN') %>
                                                    </td>

                                                    <td class="user-status">
                                                        <span
                                                            class="badge <%= user.isBlocked ? 'bg-danger' : 'bg-success' %>">
                                                            <%= user.isBlocked ? 'Blocked' : 'Active' %>
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <button class="btn btn-sm btn-primary view-btn"
                                                            data-id="<%= user._id %>">
                                                            View
                                                        </button>

                                                        <% if(user.isBlocked) { %>
                                                            <button class="btn btn-sm btn-success toggle-btn"
                                                                data-id="<%= user._id %>" data-action="unblock">
                                                                Unblock
                                                            </button>
                                                            <% } else { %>
                                                                <button class="btn btn-sm btn-danger toggle-btn"
                                                                    data-id="<%= user._id %>" data-action="block">
                                                                    Block
                                                                </button>
                                                                <% } %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="card-footer bg-white py-3">
                            <nav aria-label="Page navigation">
                                <ul class="pagination justify-content-center mb-0">
                                    <% if (hasPrevPage) { %>
                                        <li class="page-item">
                                            <a class="page-link" href="?page=<%= currentPage - 1 %>"
                                                aria-label="Previous">
                                                <span aria-hidden="true">«</span>
                                            </a>
                                        </li>
                                        <% } %>
                                            <% for(let i=1; i <=totalPages; i++) { %>
                                                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                    <a class="page-link" href="?page=<%= i %>&search=<%= search %>">
                                                        <%= i %>
                                                    </a>
                                                </li>
                                                <% } %>
                                                    <% if (hasNextPage) { %>
                                                        <li class="page-item">
                                                            <a class="page-link" href="?page=<%= currentPage + 1 %>"
                                                                aria-label="Next">
                                                                <span aria-hidden="true">»</span>
                                                            </a>
                                                        </li>
                                                        <% } %>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Modal for User Details -->
    <div class="modal fade" id="userDetailsModal" tabindex="-1" role="dialog" aria-labelledby="userDetailsModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 rounded-3">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="userDetailsModalLabel">User Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="user-details-content">

                        <p><strong>Name:</strong> <span id="user-name"></span></p>
                        <p><strong>Email:</strong> <span id="user-email"></span></p>
                        <p><strong>Join Date:</strong> <span id="user-join-date"></span></p>
                        <p><strong>Status:</strong> <span id="user-status"></span></p>
                        <p><strong>Wallet Balance:</strong> <span id="user-wallet"></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include("../partials/admin/footer.ejs") %>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>


        <script>
            document.addEventListener('DOMContentLoaded', () => {



                //  BLOCK / UNBLOCK
                document.querySelectorAll('.toggle-btn').forEach(button => {

                    button.addEventListener('click', async () => {

                        const userId = button.dataset.id;
                        const action = button.dataset.action;
                        const url = action === 'block'
                            ? '/admin/users/block'
                            : '/admin/users/unblock';

                        // CONFIRMATION
                        const confirm = await Swal.fire({
                            title: 'Are you sure?',
                            icon: 'warning',
                            showCancelButton: true
                        });

                        if (!confirm.isConfirmed) return;

                        button.disabled = true;

                        try {
                            const res = await fetch(url, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',

                                },
                                credentials: 'include',
                                body: JSON.stringify({ id: userId })
                            });

                            const data = await res.json();

                            if (data.success) {
                                Swal.fire('Success', data.message, 'success');

                                // UPDATE BUTTON
                                button.dataset.action = action === 'block' ? 'unblock' : 'block';
                                button.className = action === 'block'
                                    ? 'btn btn-sm btn-success toggle-btn'
                                    : 'btn btn-sm btn-danger toggle-btn';
                                button.textContent = action === 'block' ? 'Unblock' : 'Block';

                                // UPDATE STATUS BADGE
                                const statusCell = button.closest('tr').querySelector('.user-status span');
                                statusCell.textContent = action === 'block' ? 'Blocked' : 'Active';
                                statusCell.className = action === 'block'
                                    ? 'badge bg-danger'
                                    : 'badge bg-success';
                            }

                        } catch (err) {
                            Swal.fire('Error', err.message, 'error');
                        } finally {
                            button.disabled = false;
                        }
                    });
                });

                // VIEW USER DETAILS
                document.querySelectorAll('.view-btn').forEach(btn => {

                    btn.addEventListener('click', async () => {

                        const userId = btn.dataset.id;

                        try {
                            const res = await fetch(`/admin/users/details/${userId}`, {
                                credentials: 'include'
                            });

                            const data = await res.json();

                            if (data.success) {
                                const u = data.user;

                                // SET DATA
                                document.getElementById('user-name').textContent = u.name || 'N/A';
                                document.getElementById('user-email').textContent = u.email || 'N/A';
                                document.getElementById('user-join-date').textContent =
                                    new Date(u.createdAt).toLocaleDateString('en-IN');

                                document.getElementById('user-status').textContent =
                                    u.isBlocked ? 'Blocked' : 'Active';

                                document.getElementById('user-wallet').textContent =
                                    typeof u.walletBalance === 'number'
                                        ? `₹${u.walletBalance.toFixed(2)}`
                                        : '₹0.00';

                                //  OPEN MODAL AFTER DATA SET
                                const modal = new bootstrap.Modal(
                                    document.getElementById('userDetailsModal')
                                );
                                modal.show();
                            }
                        } catch (err) {
                            Swal.fire('Error', 'Failed to load user details', 'error');
                        }
                    });
                });

            });
        </script>