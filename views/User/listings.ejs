<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DashDrive Car Collection | DashDrive</title>
    <meta name="description"
        content="Experience the thrill of driving premium vehicles. Browse our exclusive collection of luxury cars available for test drives.">


    <!-- Google Fonts -->
    <link rel="stylesheet" href="/css/global-fonts.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">


    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/user/listings.css">

</head>

<body>

    <!-- Navigation Bar -->
    <%- include('../partials/user/header.ejs') %>

        <!-- Hero Section -->
        <section class="hero-section">
            <div class="container-fluid px-0">
                <div class="row no-gutters align-items-center">
                    <div class="col-md-6">
                        <div class="hero-content">
                            <h1 class="listing-title font-display">Experience Luxury<br>Drive Excellence</h1>
                            <p class="listing-subtitle">Discover our exclusive collection of premium vehicles from
                                trusted dealers. Book your test drive today and experience automotive excellence
                                firsthand.</p>
                            <div class="hero-stats">
                                <div class="stat-item">
                                    <div class="stat-number">100+</div>
                                    <div class="stat-label">Premium Cars</div>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-number">20+</div>
                                    <div class="stat-label">Verified Dealers</div>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-number">4.9★</div>
                                    <div class="stat-label">Customer Rating</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 position-relative">
                        <div class="hero-visual">
                            <div class="hero-image-wrapper">
                                <div class="gradient-overlay"></div>
                            </div>
                            <div class="decorative-blur blur-1"></div>
                            <div class="decorative-blur blur-2"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- Advanced Filter Bar -->
        <form action="/cars" method="GET" class="filters-container" id="filterForm">
            <!-- Search -->
            <div class="search-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input type="text" name="search" class="filter-input" placeholder="Search by model or brand..."
                    value="<%= query.search || '' %>">
            </div>

            <!-- Brand Filter -->
            <div class="filter-group">
                <select name="brand" class="filter-select" onchange="this.form.submit()">
                    <option value="">All Brands</option>
                    <% if(typeof brands !=='undefined' && brands.length> 0) { %>
                        <% brands.forEach(brand=> { %>
                            <option value="<%= brand._id %>" <%=(query.brand && query.brand===brand._id.toString())
                                ? 'selected' : '' %>>
                                <%= brand.name %>
                            </option>
                            <% }); %>
                                <% } %>
                </select>
            </div>

            <!-- Fuel Type -->
            <div class="filter-group">
                <select name="fuel" class="filter-select" onchange="this.form.submit()">
                    <option value="">All Fuel Types</option>
                    <option value="Petrol" <%=query.fuel==='Petrol' ? 'selected' : '' %>>Petrol</option>
                    <option value="Diesel" <%=query.fuel==='Diesel' ? 'selected' : '' %>>Diesel</option>
                    <option value="Electric" <%=query.fuel==='Electric' ? 'selected' : '' %>>Electric</option>
                    <option value="Hybrid" <%=query.fuel==='Hybrid' ? 'selected' : '' %>>Hybrid</option>
                </select>
            </div>

            <!-- Body Type -->
            <div class="filter-group">
                <select name="category" class="filter-select" onchange="this.form.submit()">
                    <option value="">All Body Types</option>
                    <option value="Sedan" <%=query.category==='Sedan' ? 'selected' : '' %>>Sedan</option>
                    <option value="SUV" <%=query.category==='SUV' ? 'selected' : '' %>>SUV</option>
                    <option value="Hatchback" <%=query.category==='Hatchback' ? 'selected' : '' %>>Hatchback
                    </option>
                    <option value="Coupe" <%=query.category==='Coupe' ? 'selected' : '' %>>Coupe</option>
                </select>
            </div>

            <!-- Price Sorting -->
            <div class="filter-group">
                <select name="sort" class="filter-select" onchange="this.form.submit()">
                    <option value="newest" <%=query.sort==='newest' ? 'selected' : '' %>>Newest First</option>
                    <option value="price_low" <%=query.sort==='price_low' ? 'selected' : '' %>>Price: Low to High
                    </option>
                    <option value="price_high" <%=query.sort==='price_high' ? 'selected' : '' %>>Price: High to Low
                    </option>
                </select>
            </div>

            <!-- Reset Button -->
            <a href="/cars" class="btn-filter-action btn-reset" title="Clear Filters">
                <i class="fas fa-redo-alt"></i>
            </a>
        </form>
        </section>

        <!-- Listings Grid -->
        <main class="listing-grid-wrapper">
            <div class="results-meta">
                <div class="result-count">
                    Showing <%= (cars && cars.length) || 0 %> Results
                </div>
            </div>

            <div class="car-grid">
                <% if (cars && cars.length> 0) { %>
                    <% cars.forEach(car=> { %>
                        <article class="car-card">
                            <!-- Image Container-->
                            <div class="card-image-wrapper">
                                <img src="<%= (car.images && car.images.length > 0) ? car.images[0] : 'https://via.placeholder.com/400x300?text=Premium+Car' %>"
                                    alt="<%= car.brand ? car.brand.name : '' %> <%= car.model %>" class="card-img"
                                    loading="lazy">



                                <button class="like-btn" title="Add to Wishlist">
                                    <i class="far fa-heart"></i>
                                </button>
                            </div>

                            <!-- Content Container -->
                            <div class="card-content">
                                <div class="card-brand">
                                    <%= car.brand ? car.brand.name : 'Unknown' %>
                                </div>
                                <h3 class="card-title">
                                    <%= car.model %>
                                </h3>

                                <div class="card-rating">
                                    <i class="fas fa-star star-icon"></i>
                                    <span>4.8</span> 
                                </div>

                                <div class="specs-grid">
                                    <div class="spec-item">
                                        <span class="spec-icon"><i class="fas fa-gas-pump"></i></span>
                                        <span>
                                            <%= car.fuelType %>
                                        </span>
                                    </div>
                                    <div class="spec-item">
                                        <span class="spec-icon"><i class="fas fa-car-side"></i></span>
                                        <span>
                                            <%= car.carType || 'Sedan' %>
                                        </span>
                                    </div>
                                    <div class="spec-item">
                                        <span class="spec-icon"><i class="fas fa-users"></i></span>
                                        <span>4 Seats</span>
                                    </div>
                                    <div class="spec-item">
                                        <span class="spec-icon"><i class="fas fa-tachometer-alt"></i></span>
                                        <span>
                                            <%= car.mileage || '15 km/l' %>
                                        </span>
                                    </div>
                                </div>

                                <div class="card-footer">
                                    <div class="price-block">
                                        <span class="price-label">Starting at</span>
                                        <span class="price-amount">₹<%= car.chargePerSlot %></span>
                                    </div>

                                    <div class="action-group">
                                        <a href="/cars/<%= car._id %>" class="btn-view">Details</a>
                                        <a href="/bookings/new/<%= car._id %>" class="btn-book">
                                            Book Drive <i class="fas fa-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                        <% }); %>
                            <% } else { %>
                                <!-- Empty State -->
                                <div class="empty-state">
                                    <div class="empty-icon">
                                        <i class="fas fa-car-crash"></i>
                                    </div>
                                    <h3 class="font-display" style="color: var(--primary); margin-bottom: 0.5rem;">No
                                        cars found</h3>
                                    <p>Try adjusting your search or filters to find what you're looking for.</p>
                                    <a href="/cars" class="btn-book"
                                        style="display: inline-block; margin-top: 1.5rem;">View All Cars</a>
                                </div>
                                <% } %>
            </div>
        </main>

        <!-- Footer -->
        <%- include('../partials/user/footer.ejs') %>

            <!-- Bootstrap JS and Dependencies -->
            <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
            <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
            <script src="/js/user/landingPage.js"></script>

</body>

</html>