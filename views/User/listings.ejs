<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DashDrive Car Collection | DashDrive</title>
    <meta name="description"
        content="Experience the thrill of driving premium vehicles. Browse our exclusive collection of luxury cars available for test drives.">


    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Bootstrap CSS (Required for Navbar) -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">


    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            /* Premium Color Palette */
            --primary: #0f172a;
            --primary-light: #1e293b;
            --accent: #3b82f6;
            --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            --accent-hover: #1d4ed8;

            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;

            --surface-100: #ffffff;
            --surface-200: #f8fafc;
            --surface-300: #f1f5f9;

            --text-main: #0f172a;
            --text-secondary: #64748b;
            --text-light: #94a3b8;

            --border: #e2e8f0;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 20px;

            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);

            --font-display: 'Outfit', sans-serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--surface-200);
            color: var(--text-main);
            font-family: var(--font-body);
            -webkit-font-smoothing: antialiased;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Typography utility */
        .font-display {
            font-family: var(--font-display);
        }

        .text-gradient {
            background: linear-gradient(135deg, var(--text-main) 0%, var(--text-secondary) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Navbar (Assuming dynamic include, simply styled here for context) */


        /* Hero Section */
        .listing-hero {
            padding: 4rem 2rem 2rem;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }

        .listing-header {
            max-width: 800px;
            margin-bottom: 3rem;
        }

        .listing-title {
            font-size: 3rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 1rem;
            color: var(--primary);
        }

        .listing-subtitle {
            font-size: 1.125rem;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* Filters Bar */
        .filters-container {
            background: var(--surface-100);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border);
            margin-bottom: 3rem;
            display: grid;
            grid-template-columns: 2fr repeat(4, 1fr) auto;
            gap: 1rem;
            align-items: center;
        }

        .search-wrapper {
            position: relative;
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-light);
            pointer-events: none;
        }

        .filter-input {
            width: 100%;
            padding: 0.875rem 1rem 0.875rem 2.75rem;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            font-family: var(--font-body);
            font-size: 0.95rem;
            transition: all 0.2s;
            background: var(--surface-300);
        }

        .filter-select {
            appearance: none;
            width: 100%;
            padding: 0.875rem 1rem;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            background-color: var(--surface-100);
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2364748b' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
            background-position: right 0.75rem center;
            background-repeat: no-repeat;
            background-size: 1.25em 1.25em;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.2s;
        }

        .filter-input:focus,
        .filter-select:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            background-color: var(--surface-100);
        }

        .btn-filter-action {
            padding: 0.875rem 1.5rem;
            border-radius: var(--radius-md);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-reset {
            background: var(--surface-200);
            color: var(--text-main);
            border: 1px solid var(--border);
        }

        .btn-reset:hover {
            background: var(--surface-300);
            color: var(--danger);
            border-color: var(--danger);
        }

        /* Grid Layout */
        .listing-grid-wrapper {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem 4rem;
        }

        .results-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .result-count {
            font-weight: 600;
            color: var(--text-secondary);
        }

        .car-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2.5rem;
        }

        /* Premium Car Card */
        .car-card {
            background: var(--surface-100);
            border-radius: var(--radius-lg);
            overflow: hidden;
            border: 1px solid rgba(226, 232, 240, 0.8);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-sm);
        }

        .car-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-xl);
            border-color: rgba(59, 130, 246, 0.3);
        }

        /* Image Area */
        .card-image-wrapper {
            position: relative;
            width: 100%;
            height: 260px;
            /* Taller luxury aspect ratio */
            overflow: hidden;
            background-color: #e2e8f0;
        }

        .card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .car-card:hover .card-img {
            transform: scale(1.08);
            /* Semantic Zoom */
        }

        /* Badges */
        .badge-overlay {
            position: absolute;
            top: 1rem;
            left: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            z-index: 2;
        }

        .badge-item {
            padding: 0.35rem 0.85rem;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            backdrop-filter: blur(8px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .badge-new {
            background: rgba(16, 185, 129, 0.9);
            color: white;
        }



        .like-btn {
            position: absolute;
            top: 1rem;
            right: 1rem;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-light);
            border: none;
            cursor: pointer;
            z-index: 2;
            transition: all 0.2s;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        .like-btn:hover {
            transform: scale(1.1);
            color: var(--danger);
            background: white;
        }

        /* Card Content */
        .card-content {
            padding: 1.75rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .card-brand {
            font-size: 0.75rem;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 1.2px;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .card-title {
            font-family: var(--font-display);
            font-size: 1.5rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .card-rating {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            color: var(--text-secondary);
            margin-bottom: 1.25rem;
        }

        .star-icon {
            color: var(--warning);
        }

        /* Specs Grid */
        .specs-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--border);
        }

        .spec-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .spec-icon {
            color: var(--text-light);
            width: 18px;
            text-align: center;
        }

        /* Pricing & Actions */
        .card-footer {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .price-block {
            display: flex;
            flex-direction: column;
        }

        .price-label {
            font-size: 0.75rem;
            color: var(--text-light);
            font-weight: 500;
        }

        .price-amount {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--primary);
            font-family: var(--font-display);
        }

        .action-group {
            display: flex;
            gap: 0.75rem;
        }

        .btn-view {
            padding: 0.6rem 1rem;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            background: transparent;
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.875rem;
            transition: all 0.2s;
            text-decoration: none;
        }

        .btn-view:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        .btn-book {
            padding: 0.6rem 1.25rem;
            background: var(--text-main);
            color: white;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 0.875rem;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-book:hover {
            background: var(--accent);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

        /* Empty State */
        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 6rem 1rem;
            color: var(--text-secondary);
        }

        .empty-icon {
            font-size: 4rem;
            color: var(--border);
            margin-bottom: 1.5rem;
        }

        /* Footer (Simple Placeholder) */
        footer {
            margin-top: auto;
            background: white;
            padding: 2rem;
            border-top: 1px solid var(--border);
            text-align: center;
            color: var(--text-light);
        }

        /* Responsive Breakpoints */
        @media (max-width: 1024px) {
            .car-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .filters-container {
                grid-template-columns: 1fr 1fr;
            }

            .search-wrapper {
                grid-column: 1 / -1;
            }
        }

        @media (max-width: 768px) {
            .car-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .listing-title {
                font-size: 2.25rem;
            }

            .filters-container {
                grid-template-columns: 1fr;
                padding: 1rem;
            }

            .listing-grid-wrapper {
                padding: 0 1rem 3rem;
            }

            .listing-hero {
                padding: 3rem 1.5rem 1.5rem;
            }
        }
    </style>
</head>

<body>

    <!-- Header Navigation (Keep existing consistent header partial) -->
    <%- include('../partials/user/header.ejs') %>

        <!-- Hero Section -->
        <section class="listing-hero animate-fade-in">
            <div class="listing-header">
                <h1 class="listing-title font-display">Featured Models</h1>
                <p class="listing-subtitle">Discover our exclusive fleet of verified vehicles.
                    Drive premium cars, compare models, and choose the one that fits your lifestyle..</p>
            </div>

            <!-- Advanced Filter Bar -->
            <form action="/cars" method="GET" class="filters-container" id="filterForm">
                <!-- Search -->
                <div class="search-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" name="search" class="filter-input" placeholder="Search by model or brand..."
                        value="<%= query.search || '' %>">
                </div>

                <!-- Brand Filter -->
                <div class="filter-group">
                    <select name="brand" class="filter-select" onchange="this.form.submit()">
                        <option value="">All Brands</option>
                        <% if(typeof brands !=='undefined' && brands.length> 0) { %>
                            <% brands.forEach(brand=> { %>
                                <option value="<%= brand._id %>" <%=(query.brand && query.brand===brand._id.toString())
                                    ? 'selected' : '' %>>
                                    <%= brand.name %>
                                </option>
                                <% }); %>
                                    <% } %>
                    </select>
                </div>

                <!-- Fuel Type -->
                <div class="filter-group">
                    <select name="fuel" class="filter-select" onchange="this.form.submit()">
                        <option value="">All Fuel Types</option>
                        <option value="Petrol" <%=query.fuel==='Petrol' ? 'selected' : '' %>>Petrol</option>
                        <option value="Diesel" <%=query.fuel==='Diesel' ? 'selected' : '' %>>Diesel</option>
                        <option value="Electric" <%=query.fuel==='Electric' ? 'selected' : '' %>>Electric</option>
                        <option value="Hybrid" <%=query.fuel==='Hybrid' ? 'selected' : '' %>>Hybrid</option>
                    </select>
                </div>

                <!-- Body Type -->
                <div class="filter-group">
                    <select name="category" class="filter-select" onchange="this.form.submit()">
                        <option value="">All Body Types</option>
                        <option value="Sedan" <%=query.category==='Sedan' ? 'selected' : '' %>>Sedan</option>
                        <option value="SUV" <%=query.category==='SUV' ? 'selected' : '' %>>SUV</option>
                        <option value="Hatchback" <%=query.category==='Hatchback' ? 'selected' : '' %>>Hatchback
                        </option>
                        <option value="Coupe" <%=query.category==='Coupe' ? 'selected' : '' %>>Coupe</option>
                    </select>
                </div>

                <!-- Price Sorting -->
                <div class="filter-group">
                    <select name="sort" class="filter-select" onchange="this.form.submit()">
                        <option value="newest" <%=query.sort==='newest' ? 'selected' : '' %>>Newest First</option>
                        <option value="price_low" <%=query.sort==='price_low' ? 'selected' : '' %>>Price: Low to High
                        </option>
                        <option value="price_high" <%=query.sort==='price_high' ? 'selected' : '' %>>Price: High to Low
                        </option>
                    </select>
                </div>

                <!-- Reset Button -->
                <a href="/cars" class="btn-filter-action btn-reset" title="Clear Filters">
                    <i class="fas fa-redo-alt"></i>
                </a>
            </form>
        </section>

        <!-- Listings Grid -->
        <main class="listing-grid-wrapper">
            <div class="results-meta">
                <div class="result-count">
                    Showing <%= (cars && cars.length) || 0 %> Results
                </div>
            </div>

            <div class="car-grid">
                <% if (cars && cars.length> 0) { %>
                    <% cars.forEach(car=> { %>
                        <article class="car-card">
                            <!-- Image Container with Badges -->
                            <div class="card-image-wrapper">
                                <img src="<%= (car.images && car.images.length > 0) ? car.images[0] : 'https://via.placeholder.com/400x300?text=Premium+Car' %>"
                                    alt="<%= car.brand ? car.brand.name : '' %> <%= car.model %>" class="card-img"
                                    loading="lazy">



                                <button class="like-btn" title="Add to Wishlist">
                                    <i class="far fa-heart"></i>
                                </button>
                            </div>

                            <!-- Content Container -->
                            <div class="card-content">
                                <div class="card-brand">
                                    <%= car.brand ? car.brand.name : 'Unknown' %>
                                </div>
                                <h3 class="card-title">
                                    <%= car.model %>
                                </h3>

                                <div class="card-rating">
                                    <i class="fas fa-star star-icon"></i>
                                    <span>4.8 (12 Test Drives)</span> <!-- Static data for UI -->
                                </div>

                                <div class="specs-grid">
                                    <div class="spec-item">
                                        <span class="spec-icon"><i class="fas fa-gas-pump"></i></span>
                                        <span>
                                            <%= car.fuelType %>
                                        </span>
                                    </div>
                                    <div class="spec-item">
                                        <span class="spec-icon"><i class="fas fa-car-side"></i></span>
                                        <span>
                                            <%= car.carType || 'Sedan' %>
                                        </span>
                                    </div>
                                    <div class="spec-item">
                                        <span class="spec-icon"><i class="fas fa-users"></i></span>
                                        <span>4 Seats</span>
                                    </div>
                                    <div class="spec-item">
                                        <span class="spec-icon"><i class="fas fa-tachometer-alt"></i></span>
                                        <span>
                                            <%= car.mileage || '15 km/l' %>
                                        </span>
                                    </div>
                                </div>

                                <div class="card-footer">
                                    <div class="price-block">
                                        <span class="price-label">Starting at</span>
                                        <span class="price-amount">₹<%= car.chargePerSlot %></span>
                                    </div>

                                    <div class="action-group">
                                        <a href="/cars/<%= car._id %>" class="btn-view">Details</a>
                                        <a href="/bookings/new/<%= car._id %>" class="btn-book">
                                            Book Drive <i class="fas fa-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                        <% }); %>
                            <% } else { %>
                                <!-- Empty State -->
                                <div class="empty-state">
                                    <div class="empty-icon">
                                        <i class="fas fa-car-crash"></i>
                                    </div>
                                    <h3 class="font-display" style="color: var(--primary); margin-bottom: 0.5rem;">No
                                        cars found</h3>
                                    <p>Try adjusting your search or filters to find what you're looking for.</p>
                                    <a href="/cars" class="btn-book"
                                        style="display: inline-block; margin-top: 1.5rem;">View All Cars</a>
                                </div>
                                <% } %>
            </div>
        </main>

        <!-- Footer -->
        <%- include('../partials/user/footer.ejs') %>

            <script>
                // Simple helper for search input debounce or auto-submit if desired, 
                // but for now relying on Enter key for search and onchange for selects
            </script>
</body>

</html>