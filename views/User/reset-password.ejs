<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - DashDrive</title>

  <!-- Global Font System -->
  <link rel="stylesheet" href="/css/global-fonts.css">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/modern-style.css">

  <!-- SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

  <style>
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: #f8f9fa;
      position: relative;
      padding-top: 20px;
    }

    .main-logo {
      position: absolute;
      top: 20px;
      left: 30px;
      font-size: 2.5rem;
      font-weight: 700;
      text-decoration: none;
      z-index: 1000;
    }

    .main-logo span {
      color: #8bbd76;
    }

    .card {
      background: #f5da9a;
      border: none;
      border-radius: 14px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

    .card-body {
      padding: 2.5rem;
    }

    .card-title {
      color: #333333;
      font-weight: 600;
      text-align: center;
      font-size: 1.85rem;
      margin-bottom: 1.8rem;
    }

    .form-control {
      padding: 0.75rem 1rem;
      border: none;
      border-bottom: 2px solid #eee;
      border-radius: 0;
      background-color: transparent;
      transition: all 0.3s;
    }

    .form-control:focus {
      border-color: #007bff;
      box-shadow: none;
      background-color: transparent;
    }

    .form-label {
      color: #6c757d;
      font-weight: 500;
    }

    .btn-primary {
      background-color: #33333f;
      border: none;
      padding: 0.75rem 1.5rem;
      font-weight: 500;
      border-radius: 13px;
      transition: all 0.3s;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .btn-primary:hover {
      background-color: #1a1a1a;
      transform: translateY(-1px);
    }

    .error-message {
      color: #dc3545;
      font-size: 0.875rem;
      margin-top: 0.25rem;
      display: none;
    }

    .is-invalid {
      border-color: #dc3545;
    }

    /* Password Toggle Styles */
    .password-field {
      position: relative;
    }

    .password-toggle {
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #6c757d;
      transition: color 0.3s ease;
    }

    .password-toggle:hover {
      color: #007bff;
    }
  </style>
</head>

<body>

  <a href="/" class="main-logo text-dark text-decoration-none">Dash<span>Drive</span></a>

  <section class="content-main d-flex align-items-center justify-content-center"
    style="min-height: calc(100vh - 160px);">
    <div class="card mx-auto card-login col-md-4 col-sm-8 col-11">
      <div class="card-body">
        <h4 class="card-title mb-4">Reset Password</h4>

        <form id="resetForm" method="POST" class="needs-validation" novalidate>
          <input type="hidden" name="token" id="token" value="<%= token %>">
          <input type="hidden" name="email" id="email" value="<%= email %>">

          <div class="mb-4">
            <label for="password" class="form-label">New Password</label>
            <div class="password-field">
              <input type="password" class="form-control" id="password" name="password" placeholder="Enter new password"
                required />
              <span class="password-toggle" onclick="togglePassword('password')">
                <i class="far fa-eye"></i>
              </span>
            </div>
            <div id="errorPassword" class="error-message"></div>
          </div>

          <div class="mb-4">
            <label for="confirmPassword" class="form-label">Confirm Password</label>
            <div class="password-field">
              <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                placeholder="Confirm new password" required />
              <span class="password-toggle" onclick="togglePassword('confirmPassword')">
                <i class="far fa-eye"></i>
              </span>
            </div>
            <div id="errorConfirmPassword" class="error-message"></div>
          </div>

          <% if (typeof message !=='undefined' ) { %>
            <p style="color: red; text-align: center;">
              <%= message %>
            </p>
            <% } %>

              <div class="mb-4">
                <button type="submit" class="btn btn-primary w-100">Reset Password</button>
              </div>
        </form>

        <p class="text-center mb-4">Remembered your password? <a href="/login">Login</a></p>
      </div>
    </div>
  </section>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

  <script>
    const resetForm = document.getElementById("resetForm");
    const password = document.getElementById("password");
    const confirmPassword = document.getElementById("confirmPassword");
    const errorPassword = document.getElementById("errorPassword");
    const errorConfirmPassword = document.getElementById("errorConfirmPassword");
    const token = document.querySelector('input[name="token"]').value;
    const email = document.querySelector('input[name="email"]').value;

    function togglePassword(fieldId) {
      const passwordField = document.getElementById(fieldId);
      const icon = event.currentTarget.querySelector("i");
      if (passwordField.type === "password") {
        passwordField.type = "text";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
      } else {
        passwordField.type = "password";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
      }
    }

    function validatePassword() {
      const passVal = password.value;
      const cPassVal = confirmPassword.value;
      const passwordPattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@#$!%*?&])[A-Za-z\d@#$!%*?&]{8,}$/;
      let isValid = true;

      // Reset error styles
      password.classList.remove('is-invalid');
      confirmPassword.classList.remove('is-invalid');

      if (!passVal.trim()) {
        errorPassword.style.display = "block";
        errorPassword.innerHTML = "Password is required";
        password.classList.add('is-invalid');
        isValid = false;
      } else if (passVal.length < 8) {
        errorPassword.style.display = "block";
        errorPassword.innerHTML = "Password must be at least 8 characters";
        password.classList.add('is-invalid');
        isValid = false;
      } else if (!passwordPattern.test(passVal)) {
        errorPassword.style.display = "block";
        errorPassword.innerHTML = "Password must include lowercase, uppercase, digit, and special character";
        password.classList.add('is-invalid');
        isValid = false;
      } else {
        errorPassword.style.display = "none";
      }

      if (!cPassVal.trim()) {
        errorConfirmPassword.style.display = "block";
        errorConfirmPassword.innerHTML = "Confirm password is required";
        confirmPassword.classList.add('is-invalid');
        isValid = false;
      } else if (passVal !== cPassVal) {
        errorConfirmPassword.style.display = "block";
        errorConfirmPassword.innerHTML = "Passwords do not match";
        confirmPassword.classList.add('is-invalid');
        isValid = false;
      } else {
        errorConfirmPassword.style.display = "none";
      }

      return isValid;
    }

    resetForm.addEventListener("submit", function (e) {
      e.preventDefault();

      if (!validatePassword()) {
        return;
      }

      const formData = {
        token: token,
        email: email,
        password: password.value,
        confirmPassword: confirmPassword.value
      };

      $.ajax({
        type: "POST",
        url: "/reset-password",
        data: formData,
        success: function (response) {
          if (response.success) {
            Swal.fire({
              icon: "success",
              title: "Password Reset",
              text: "Your password has been successfully reset",
              showConfirmButton: false,
              timer: 1500
            }).then(() => {
              window.location.href = "/login";
            });
          }
        },
        error: function (xhr) {
          const errorMessage = xhr.responseJSON?.message || "An error occurred";
          Swal.fire({
            icon: "error",
            title: "Reset Failed",
            text: errorMessage
          });
        }
      });
    });
  </script>
</body>

</html>