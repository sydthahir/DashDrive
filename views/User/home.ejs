<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dash Drive</title>
    <link rel="stylesheet" href="/css/global-fonts.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
   <link rel="stylesheet" href="/css/user/landingPage.css">
</head>

<body>
    <!-- Navigation Bar -->
    <%- include('../partials/user/header.ejs') %>

        <!-- Hero Section -->
        <section class="hero-section">
            <div class="container-fluid px-0">
                <div class="row no-gutters">
                    <div class="col-md-6">
                        <div class="hero-content">
                            <h1>Online Test Drive<br>Booking</h1>
                            <p>Discover our diverse range of brands and models. Here you'll find your personal dream
                                vehicle.</p>
                            <a class="btn btn-primary" href="/cars">Get Started</a>
                        </div>
                    </div>
                    <div class="col-md-6 position-relative">
                        <div class="diagonal-cut">
                            <img src="/images/homeCar.png" class="img-fluid" alt="Luxury Car">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Explore Our Premium Brands Section -->
        <section class="premium-brands py-5 text-center">
            <div class="container">
                <h2 class="mb-4">Explore Our Premium Brands</h2>
                <div class="row">
                    <div class="col-6 col-md-2 mb-3">
                        <div class="brand-item">
                            <img src="/images/Carlogos/audi_logo.webp" alt="Audi">
                            <p class="brand-name">Audi</p>
                        </div>
                    </div>
                    <div class="col-6 col-md-2 mb-3">
                        <div class="brand-item">
                            <img src="/images/Carlogos/bmw_logo.webp" alt="BMW">
                            <p class="brand-name">BMW</p>
                        </div>
                    </div>
                    <div class="col-6 col-md-2 mb-3">
                        <div class="brand-item">
                            <img src="/images/Carlogos/ford_logo.webp" alt="Ford">
                            <p class="brand-name">Ford</p>
                        </div>
                    </div>
                    <div class="col-6 col-md-2 mb-3">
                        <div class="brand-item">
                            <img src="/images/Carlogos/mercedes_logo.jpeg" alt="Mercedes-Benz">
                            <p class="brand-name">Mercedes-Benz</p>
                        </div>
                    </div>
                    <div class="col-6 col-md-2 mb-3">
                        <div class="brand-item">
                            <img src="/images/Carlogos/bently_log.png" alt="Bentley">
                            <p class="brand-name">Bentley</p>
                        </div>
                    </div>
                    <div class="col-6 col-md-2 mb-3">
                        <div class="brand-item">
                            <img src="/images/Carlogos/volkswagon_logo.png" alt="Volkswagen">
                            <p class="brand-name">Volkswagen</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Search Section -->
        <section class="search-section">
            <div class="container">
                <div class="text-center">
                    <div class="search-header justify-content-center">
                        <i class="fas fa-check-circle"></i>
                        <h2>Search over 150,000 vehicles</h2>
                    </div>
                    <p>Explore thousands of trusted used cars and SUVs across India, sourced from our nationwide network
                        of
                        verified dealers.".</p>
                    <a href="/cars" class="search-btn">Search Cars <i class="fas fa-arrow-right ms-2"></i></a>

                    <div class="browse-text">Or browse by type:</div>
                    <div class="car-types">
                        <div class="car-type">Automatics Cars</div>
                        <div class="car-type">SUVs</div>
                        <div class="car-type">Electrics Cars</div>
                        <div class="car-type">New in Stock</div>
                        <div class="car-type">Petrol</div>
                        <div class="car-type">Diesel</div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Browse by Type Section -->
        <section class="browse-type py-5 text-center">
            <div class="container">
                <h2 class="mb-4">Browse by Type</h2>
                <div class="row">
                    <div class="col-md-2 col-6 mb-3">
                        <div class="card">
                            <div class="card-background" style="background-image: url('/images/SUV.png');"></div>
                            <div class="card-img-overlay d-flex align-items-center justify-content-center">
                                <h5 class="text-white">SUV</h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-3">
                        <div class="card">
                            <div class="card-background" style="background-image: url('/images/sedan.jpeg');"></div>
                            <div class="card-img-overlay d-flex align-items-center justify-content-center">
                                <h5 class="text-white">Sedan</h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-3">
                        <div class="card">
                            <div class="card-background" style="background-image: url('/images/hatchback.webp');"></div>
                            <div class="card-img-overlay d-flex align-items-center justify-content-center">
                                <h5 class="text-white">Hatchback</h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-3">
                        <div class="card">
                            <div class="card-background" style="background-image: url('/images/convertible.png');">
                            </div>
                            <div class="card-img-overlay d-flex align-items-center justify-content-center">
                                <h5 class="text-white">Convertible</h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-3">
                        <div class="card">
                            <div class="card-background" style="background-image: url('/images/Coupe.webp');"></div>
                            <div class="card-img-overlay d-flex align-items-center justify-content-center">
                                <h5 class="text-white">Coupe</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Better Way to Test Your Perfect Cars Section -->
        <section class="test-drive-process py-5 bg-light text-center">
            <div class="container">
                <h2 class="mb-4">Better Way to Test Your Perfect Cars</h2>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <i class="fas fa-car fa-3x mb-3 text-dark"></i>
                        <h5>Choose Your Model</h5>
                        <p>Select the car you want to test drive.</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <i class="fas fa-calendar-alt fa-3x mb-3 text-dark"></i>
                        <h5>Select the Slot</h5>
                        <p>Pick a convenient time for your test drive.</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <i class="fas fa-check fa-3x mb-3 text-dark"></i>
                        <h5>Reserve Your Test Car</h5>
                        <p>Confirm your booking and get ready to drive.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Featured Cars Section -->
        <section class="featured-cars py-5">
            <div class="container">
                <h2 class="mb-4">Featured Cars</h2>
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <img src="/images/m5 bmw.webp" class="card-img-top" alt="BMW M5">
                            <div class="card-body text-center">
                                <h5 class="card-title">BMW M5</h5>
                                <div class="button-group">
                                    <button class="btn btn-book">Book now</button>
                                    <button class="btn btn-details">Details</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <img src="/images/maybach.jpg" class="card-img-top" alt="Maybach S Class">
                            <div class="card-body text-center">
                                <h5 class="card-title">Maybach S Class</h5>
                                <div class="button-group">
                                    <button class="btn btn-book">Book now</button>
                                    <button class="btn btn-details">Details</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <img src="/images/mercedes.jpeg" class="card-img-top" alt="Mercedes AMG GLS">
                            <div class="card-body text-center">
                                <h5 class="card-title">Mercedes AMG GLS</h5>
                                <div class="button-group">
                                    <button class="btn btn-book">Book now</button>
                                    <button class="btn btn-details">Details</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Why Choose Us Section -->
        <section class="why-choose-us py-5">
            <div class="container">
                <h2 class="text-center mb-5">Why Choose Us?</h2>
                <div class="row">
                    <div class="col-md-3">
                        <div class="feature-card text-center">
                            <img src="/images/prmium-test.png" alt="Best Price" class="mb-3">
                            <h5>Exclusive Premium Test Drives</h5>
                            <p>Experience luxury firsthand with top-tier vehicles from verified vendors across India.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="feature-card text-center">
                            <img src="/images/rental-car.png" alt="Certified" class="mb-3">
                            <h5> Vetted & Trusted Dealers</h5>
                            <p>We partner only with certified dealers to ensure authenticity and reliability.</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="feature-card text-center">
                            <img src="/images/Car Application.png" alt="Secure" class="mb-3">
                            <h5>Seamless Booking & Payments</h5>
                            <p>Effortless reservations with secure online payments, including wallet options for added
                                convenience.</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="feature-card text-center">
                            <img src="/images/checklist.png" alt="Support" class="mb-3">
                            <h5> Flexible Test Drive Scheduling</h5>
                            <p>Choose your preferred time and location for a hassle-free test drive experience.</p>
                        </div>
                    </div>


                    <div class="col-md-3">
                        <div class="feature-card text-center">
                            <img src="/images/mechanic.png" alt="Support" class="mb-3">
                            <h5>Premium Support</h5>
                            <p>24/7 customer support to assist you with any queries or concerns.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section class="services py-5 bg-light">
            <div class="container">
                <h2 class="text-center mb-5">Explore Our Services</h2>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="service-card">
                            <div class="icon-circle">
                                <i class="fas fa-comments"></i>
                            </div>
                            <h5>Consultation</h5>
                            <p>Get personalized advice from our car experts to find your perfect match.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="service-card">
                            <div class="icon-circle">
                                <i class="fas fa-headset"></i>
                            </div>
                            <h5>Support</h5>
                            <p>Our customer support is always ready to assist you with any inquiries or issues.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="service-card">
                            <div class="icon-circle">
                                <i class="fas fa-tools"></i>
                            </div>
                            <h5>Maintenance</h5>
                            <p>Regular maintenance services to keep your test drive vehicle in top condition.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="service-card">
                            <div class="icon-circle">
                                <i class="fas fa-truck"></i>
                            </div>
                            <h5>Delivery</h5>
                            <p>On-demand test drive delivery service to your preferred location.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="service-card">
                            <div class="icon-circle">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                            <h5>Financing</h5>
                            <p>Flexible financing solutions to suit your budget and needs.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="service-card">
                            <div class="icon-circle">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <h5>Insurance</h5>
                            <p>Comprehensive insurance options for a worry-free test drive experience.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Statistics Section -->
        <section class="statistics">
            <div class="container">
                <div class="row">
                    <div class="col-md-3">
                        <div class="stat-item">
                            <div class="stat-number">28</div>
                            <p class="stat-label">Year Experienced</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <div class="stat-number">1,090</div>
                            <p class="stat-label">Total Cars</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <div class="stat-number">2,590</div>
                            <p class="stat-label">Happy Customers</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <div class="stat-number">11</div>
                            <p class="stat-label">Total Branches</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <%- include('../partials/user/footer.ejs') %>

            <!-- Bootstrap JS and Dependencies -->
            <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
            <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
            <script src="/js/user/landingPage.js"></script>
</body>

</html>