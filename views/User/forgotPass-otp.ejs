<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP - DashDrive</title>

    <!-- Global Font System -->
    <link rel="stylesheet" href="/css/global-fonts.css">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/modern-style.css">

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #faf9f6;
            position: relative;
            padding-top: 20px;
        }

        .main-logo {
            position: absolute;
            top: 5px;
            left: 20px;
            font-size: 2.5rem;
            font-weight: 700;
            text-decoration: none;

            z-index: 1000;

        }

        .main-logo span {
            color: #8bbd76;
        }

        .otp-container {
            width: 100%;
            max-width: 500px;
            margin: auto;
            background: #f5da9a;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 3rem;
            margin-top: 10rem;
        }

        .form-container {
            max-width: 400px;
            margin: 0 auto;

        }

        .otp-input-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin: 2rem 0;
        }

        .otp-input {
            width: 60px;
            height: 60px;
            text-align: center;
            font-size: 1.8rem;
            font-weight: 600;
            border: 2px solid #e1e1e1;
            border-radius: 12px;
            background: #fff;
            transition: all 0.3s ease;
        }

        .otp-input:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.1);
            outline: none;
        }

        .btn-verify {
            width: 100%;
            padding: 1rem;
            background-color: #333333;
            border: none;
            border-radius: 12px;
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .btn-verify:hover {
            background-color: #1a1a1a;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(51, 51, 51, 0.2);
        }

        .resend-timer {
            color: #2d2d2d;
            font-size: 0.9rem;
            text-align: center;
            margin-top: 1.5rem;
        }

        .error-message {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.5rem;
            display: none;
            text-align: center;
        }

        @media (max-width: 576px) {
            .otp-container {
                margin: 1rem;
                padding: 2rem;
            }

            .otp-input {
                width: 50px;
                height: 50px;
                font-size: 1.5rem;
            }

            .otp-input-group {
                gap: 10px;
            }
        }
    </style>
</head>

<body>
    <a href="/" class="main-logo text-dark text-decoration-none">Dash<span>Drive</span></a>

    <div class="container">
        <div class="otp-container">
            <div class="form-container">
                <div class="text-center mb-4">
                    <h2 class="h3 fw-bold mb-2">Email Verification</h2>
                    <p class="text-muted">
                        We've sent a verification code to your email address
                    </p>
                </div>

                <form id="otpForm" action="/verify-passForgot-otp" method="POST" class="needs-validation" novalidate>
                    <input type="hidden" name="email" id="email" value="<%= email %>">

                    <div class="otp-input-group">
                        <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" required />
                        <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" required />
                        <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" required />
                        <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" required />
                    </div>

                    <div id="otpError" class="error-message"></div>

                    <button type="submit" class="btn btn-verify mb-3">
                        Verify OTP
                    </button>

                    <div class="resend-timer text-center">
                        Didn't receive the code? <br />
                        <span id="timer">Resend in <span id="countdown">15</span>s</span>
                        <a href="#" id="resendBtn" class="d-none text-primary">Resend Code</a>
                    </div>
                    <% if (typeof message !=='undefined' ) { %>
                        <div style="display: flex; justify-content: center; align-items: center; margin-bottom: 15px;">
                            <p style="color: red; text-align: center; max-width: 90%; word-wrap: break-word;">
                                <%= message %>
                            </p>
                        </div>
                        <% } %>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="/js/user/forgot-password.js"></script>
</body>

</html>