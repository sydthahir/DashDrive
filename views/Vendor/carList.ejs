<!-- Success/Error Messages -->
<% if (query.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        <%= query.success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>
        <% if (query.error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>
                <%= query.error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

                <div class="dashboard-header">
                    <div class="header-title">Manage Your Cars</div>
                    <a href="/vendor/cars/register-cars" class="new-car-btn">
                        <i class="fas fa-plus"></i>
                        Register New Car
                    </a>
                </div>

                <div class="search-container">
                    <input type="text" id="searchInput" class="search-input"
                        placeholder="Search by model name or registration number">
                </div>

                <div class="cars-table table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th>Image</th>
                                <th>Model Name</th>
                                <th>Brand</th>
                                <th>Registration</th>
                                <th class="d-none d-md-table-cell">Fuel Type</th>
                                <th class="d-none d-md-table-cell">Transmission</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="carTableBody">
                            <% if (cars && cars.length> 0) { %>
                                <% cars.forEach(car=> { %>
                                    <tr>
                                        <td>
                                            <% if (car.images && car.images.length> 0) { %>
                                                <img src="<%= car.images[0] %>" alt="<%= car.model %>"
                                                    class="car-image">
                                                <% } else { %>
                                                    <img src="https://via.placeholder.com/100x60" alt="No image"
                                                        class="car-image">
                                                    <% } %>
                                        </td>
                                        <td>
                                            <%= car.model %>
                                        </td>
                                        <td>
                                            <%= car.brand ? car.brand.name : 'N/A' %>
                                        </td>
                                        <td>
                                            <%= car.registrationNumber %>
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            <%= car.fuelType || 'N/A' %>
                                        </td>
                                        <td class="d-none d-md-table-cell">Automatic</td>
                                        <td>
                                            <span class="status-badge status-<%= car.status || 'pending' %>">
                                                <%= car.status || 'Pending' %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="action-buttons">
                                                <button class="action-btn edit-btn"
                                                    data-id="<%= car._id %>">Edit</button>
                                                <button class="action-btn delete-btn"
                                                    data-id="<%= car._id %>">Delete</button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="8" class="text-center">No cars registered yet.
                                                </td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>