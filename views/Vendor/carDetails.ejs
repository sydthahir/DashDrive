<style>
    /* Details Page Specific Styles */
    .details-container {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 1.5rem;
    }

    @media (max-width: 992px) {
        .details-container {
            grid-template-columns: 1fr;
        }
    }

    /* Car Info Card */
    .car-info-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
        border: 1px solid #edf2f7;
        overflow: hidden;
        position: sticky;
        top: 90px;
        height: fit-content;
    }

    .car-main-image {
        width: 100%;
        height: 220px;
        object-fit: cover;
    }

    .car-details-body {
        padding: 1.5rem;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.75rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #f7fafc;
    }

    .info-row:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .info-label {
        color: #718096;
        font-size: 0.9rem;
    }

    .info-value {
        font-weight: 600;
        color: #2d3748;
        font-size: 0.9rem;
    }

    /* Calendar & Slots Section */
    .calendar-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
        border: 1px solid #edf2f7;
        padding: 1.5rem;
        /* min-height removed to fit content */
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.25rem;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .calendar-day-header {
        font-weight: 600;
        color: #718096;
        padding: 0.25rem;
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    .calendar-day {
        height: 60px;
        /* Fixed smaller height */
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding-top: 4px;
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
    }

    .calendar-day:hover:not(.disabled) {
        border-color: #3182ce;
        background-color: #ebf8ff;
    }

    .calendar-day.disabled {
        background-color: #f7fafc;
        color: #cbd5e0;
        cursor: not-allowed;
    }

    .calendar-day.selected {
        border-color: #3182ce;
        box-shadow: 0 0 0 2px rgba(49, 130, 206, 0.3);
    }

    .day-number {
        font-weight: 600;
        font-size: 0.8rem;
    }

    .slot-dot-container {
        display: flex;
        gap: 2px;
        align-items: center;
        justify-content: center;
        margin-top: 2px;
        flex-wrap: wrap;
        width: 100%;
        padding: 0 2px;
    }

    .slot-dot {
        width: 4px;
        /* Smaller dots */
        height: 4px;
        border-radius: 50%;
    }

    .slot-dot.available {
        background: #48bb78;
    }

    .slot-dot.booked {
        background: #3182ce;
    }

    .slot-dot.maintenance {
        background: #e53e3e;
    }

    /* Right Panel - Slot Management */
    .slot-management-panel {
        background: #f8fafc;
        border-radius: 8px;
        padding: 1rem;
        border: 1px solid #e2e8f0;
    }

    .slot-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 0.75rem;
        max-height: 250px;
        overflow-y: auto;
    }

    .slot-item {
        background: white;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .slot-time {
        font-weight: 600;
        color: #2d3748;
        font-size: 0.9rem;
    }

    .slot-status {
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 12px;
    }

    .slot-status.available {
        background: #f0fff4;
        color: #2f855a;
    }

    .slot-status.booked {
        background: #ebf8ff;
        color: #2c5282;
    }

    .btn-delete-slot {
        color: #e53e3e;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.85rem;
    }

    /* Warning Block */
    .warning-block {
        background: #fffaf0;
        border-left: 4px solid #ed8936;
        padding: 0.75rem;
        margin-bottom: 1rem;
        color: #7c4a03;
        border-radius: 4px;
        font-size: 0.85rem;
    }
</style>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-3 mb-1">
            <a href="/vendor/cars" class="btn btn-outline-secondary btn-sm rounded-circle"
                style="width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h4 class="fw-bold mb-0">Manage Availability</h4>
        </div>
        <p class="text-muted ms-5 mb-0">
            <%= car.model %> (<%= car.registrationNumber %>)
        </p>
    </div>

    <!-- Overall Car Status -->
    <div class="d-flex align-items-center gap-3">
        <% if (car.status !=='approved' ) { %>
            <div class="alert alert-warning py-2 mb-0 d-flex align-items-center">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <span>Slot creation is disabled until car is approved.</span>
            </div>
            <% } %>
                <span
                    class="badge bg-<%= car.status === 'approved' ? 'success' : (car.status === 'rejected' ? 'danger' : 'warning text-dark') %> fs-6 px-3 py-2">
                    <%= car.status.charAt(0).toUpperCase() + car.status.slice(1) %>
                </span>
    </div>
</div>

<div class="details-container">

    <!-- Left Column: Car Info -->
    <aside>
        <div class="car-info-card">
            <img src="<%= (car.images && car.images.length > 0) ? car.images[0] : 'https://via.placeholder.com/350x200' %>"
                alt="<%= car.model %>" class="car-main-image">

            <div class="car-details-body">
                <h5 class="fw-bold mb-3">
                    <%= car.brand ? car.brand.name : '' %>
                        <%= car.model %>
                </h5>

                <div class="info-row">
                    <span class="info-label">Year</span>
                    <span class="info-value">
                        <%= car.year %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Fuel Type</span>
                    <span class="info-value">
                        <%= car.fuelType %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Type</span>
                    <span class="info-value">
                        <%= car.carType %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Rate / Slot</span>
                    <span class="info-value text-success">₹<%= car.chargePerSlot %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Deposit</span>
                    <span class="info-value">₹<%= car.securityDeposit %></span>
                </div>
                <div class="mt-3">
                    <small class="text-muted d-block mb-1">Features</small>
                    <p class="small text-dark mb-0">
                        <%= car.features %>
                    </p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Right Column: Calendar & Content -->
    <main>
        <div class="calendar-card">

            <% if (car.status==='approved' ) { %>
                <div class="warning-block">
                    <i class="fas fa-info-circle me-2"></i>
                    Select a date below to manage test drive slots. Past dates cannot be edited.
                </div>
                <% } %>

                    <!-- Calendar Header -->
                    <div class="calendar-header">
                        <button class="btn btn-light btn-sm" id="prevMonth"><i class="fas fa-chevron-left"></i></button>
                        <h5 class="mb-0 fw-bold" id="currentMonthYear">January 2026</h5>
                        <button class="btn btn-light btn-sm" id="nextMonth"><i
                                class="fas fa-chevron-right"></i></button>
                    </div>

                    <!-- Calendar Grid -->
                    <div class="calendar-grid">
                        <div class="calendar-day-header">Sun</div>
                        <div class="calendar-day-header">Mon</div>
                        <div class="calendar-day-header">Tue</div>
                        <div class="calendar-day-header">Wed</div>
                        <div class="calendar-day-header">Thu</div>
                        <div class="calendar-day-header">Fri</div>
                        <div class="calendar-day-header">Sat</div>
                        <!-- Days will be generated by JS -->
                        <div id="calendarDays" class="contents" style="display: contents;"></div>
                    </div>

                    <!-- Selected Date Management Panel -->
                    <div id="slotManagementPanel" class="slot-management-panel" style="display: none;">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                            <h6 class="mb-0 fw-bold">Manage Slots for <span id="selectedDateDisplay"
                                    class="text-primary"></span></h6>

                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="dateAvailabilityToggle" checked>
                                <label class="form-check-label small" for="dateAvailabilityToggle">Date
                                    Available</label>
                            </div>
                        </div>

                        <div id="slotsContainer">
                            <form id="addSlotForm" class="row g-2 align-items-end mb-3">
                                <div class="col-4">
                                    <label class="small text-muted mb-1">Start Time</label>
                                    <input type="time" class="form-control form-control-sm" id="slotStart" required>
                                </div>
                                <div class="col-4">
                                    <label class="small text-muted mb-1">End Time</label>
                                    <input type="time" class="form-control form-control-sm" id="slotEnd" required>
                                </div>
                                <div class="col-4">
                                    <button type="submit" class="btn btn-primary btn-sm w-100" <%=car.status
                                        !=='approved' ? 'disabled title="Wait for approval"' : '' %>>
                                        <i class="fas fa-plus me-1"></i> Add Slot
                                    </button>
                                </div>
                            </form>

                            <h6 class="small text-muted mt-3 mb-2">Existing Slots</h6>
                            <div class="slot-list" id="slotsList">
                                <!-- Slots will be populated here -->
                                <div class="text-center text-muted small py-3">Select a date to view slots</div>
                            </div>
                        </div>
                        <div id="unavailableMessage" class="text-center text-danger py-4" style="display: none;">
                            <i class="fas fa-ban mb-2"></i>
                            <p class="mb-0">This date is marked as Unavailable.</p>
                        </div>
                    </div>

        </div>
    </main>
</div>

<script>
    const carId = '<%= car._id %>';
    const isApproved = <%= car.status === 'approved' %>;

    let currentDate = new Date();
    let selectedDate = null;
    let slotsData = {}; // Cache for slots: { "2024-01-24": [ {startTime, endTime, status, _id} ] }

    const monthNames = ["January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"];

    document.addEventListener('DOMContentLoaded', () => {
        renderCalendar(currentDate);

        document.getElementById('prevMonth').addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar(currentDate);
        });

        document.getElementById('nextMonth').addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar(currentDate);
        });

        document.getElementById('dateAvailabilityToggle').addEventListener('change', (e) => {
            // Logic to toggle availability
            const isAvailable = e.target.checked;
            const slotsContainer = document.getElementById('slotsContainer');
            const msg = document.getElementById('unavailableMessage');

            if (isAvailable) {
                slotsContainer.style.display = 'block';
                msg.style.display = 'none';
            } else {
                slotsContainer.style.display = 'none';
                msg.style.display = 'block';
            }

            // TODO: Save to backend
        });

        // Simulating add slot logic for UI demo
        document.getElementById('addSlotForm').addEventListener('submit', (e) => {
            e.preventDefault();
            if (!isApproved) {
                alert("Car must be approved to create slots.");
                return;
            }

            const start = document.getElementById('slotStart').value;
            const end = document.getElementById('slotEnd').value;

            if (start >= end) {
                alert("End time must be after start time");
                return;
            }

            addSlotToUI(start, end, 'available');
            // reset form
            e.target.reset();
        });
    });

    function renderCalendar(date) {
        const year = date.getFullYear();
        const month = date.getMonth();

        document.getElementById('currentMonthYear').textContent = `${monthNames[month]} ${year}`;

        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);

        const daysContainer = document.getElementById('calendarDays');
        daysContainer.innerHTML = '';

        // Padding days
        for (let i = 0; i < firstDay.getDay(); i++) {
            const div = document.createElement('div');
            div.className = 'calendar-day disabled';
            div.style.backgroundColor = '#fff';
            div.style.border = 'none';
            daysContainer.appendChild(div);
        }

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        for (let i = 1; i <= lastDay.getDate(); i++) {
            const div = document.createElement('div');
            const loopDate = new Date(year, month, i);

            div.className = 'calendar-day';
            if (loopDate < today) {
                div.classList.add('disabled');
            } else {
                div.onclick = () => selectDate(div, loopDate);
            }

            div.innerHTML = `
                <div class="day-number">${i}</div>
                <div class="slot-dot-container">
                    <!-- Dots will be real data later -->
                     <div class="slot-dot available"></div>
                </div>
            `;

            daysContainer.appendChild(div);
        }
    }

    function selectDate(element, date) {
        // Remove active class from previous
        document.querySelectorAll('.calendar-day').forEach(d => d.classList.remove('selected'));
        element.classList.add('selected');

        selectedDate = date;
        const formattedDate = date.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        document.getElementById('selectedDateDisplay').textContent = formattedDate;
        document.getElementById('slotManagementPanel').style.display = 'block';

        // Reset list
        document.getElementById('slotsList').innerHTML = '';

        // TODO: Fetch slots for this date from Backend
        // For UI demo:
        // if(date.getDate() % 2 === 0) {
        //    addSlotToUI("09:00", "10:00", "available");
        //    addSlotToUI("14:00", "15:00", "booked");
        // } else {
        //     document.getElementById('slotsList').innerHTML = '<div class="text-center text-muted small py-3">No slots created for this date</div>';
        // }
    }

    function addSlotToUI(start, end, status) {
        const list = document.getElementById('slotsList');
        // Clear empty message if any
        if (list.querySelector('.text-center')) list.innerHTML = '';

        const div = document.createElement('div');
        div.className = 'slot-item';
        div.innerHTML = `
            <div>
                <div class="slot-time">${formatTime(start)} - ${formatTime(end)}</div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="slot-status ${status}">${status}</span>
                ${status === 'available' ? '<button class="btn-delete-slot"><i class="fas fa-trash"></i></button>' : ''}
            </div>
        `;
        list.appendChild(div);

        // Add delete listener
        const delBtn = div.querySelector('.btn-delete-slot');
        if (delBtn) {
            delBtn.onclick = function () {
                div.remove();
                if (list.children.length === 0) {
                    list.innerHTML = '<div class="text-center text-muted small py-3">No slots created for this date</div>';
                }
            }
        }
    }

    function formatTime(timeStr) {
        const [hour, min] = timeStr.split(':');
        const h = parseInt(hour);
        const ampm = h >= 12 ? 'PM' : 'AM';
        const h12 = h % 12 || 12;
        return `${h12}:${min} ${ampm}`;
    }
</script>