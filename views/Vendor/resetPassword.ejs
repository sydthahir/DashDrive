<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - DashDrive Vendor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/global-fonts.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body {
            min-height: 100vh;

            background-color: #ffffff;
            padding-top: 80px;
        }

        .main-logo {
            position: absolute;
            top: 20px;
            left: 30px;
            font-size: 2.5rem;
            font-weight: 700;
            text-decoration: none;

            z-index: 1000;
        }

        .main-logo span {
            color: #8bbd76;
        }

        .login-container {
            min-height: 80vh;
            display: flex;
            align-items: center;
            padding: 2rem;
        }

        .illustration-section {
            background: url('/images/Freelancers.png') no-repeat center center;
            background-size: contain;
            min-height: 500px;
            border-radius: 20px;
            position: relative;
        }

        @media (max-width: 991px) {
            .illustration-section {
                display: none;
            }
        }

        .login-section {
            background: hwb(228 78% 9% / 0.973);
            border-radius: 20px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            padding: 3rem;
        }

        .btn-primary {
            background-color: #333333;
            border-color: #333333;
            padding: 12px 20px;
            font-weight: 500;
        }

        .btn-primary:hover {
            background-color: #1a1a1a;
            border-color: #1a1a1a;
        }

        .form-control {
            padding: 12px 15px;
            border-radius: 8px;
        }

        .form-control:focus {
            border-color: #333333;
            box-shadow: 0 0 0 0.2rem rgba(51, 51, 51, 0.1);
        }

        .login-header {
            margin-bottom: 2rem;
        }

        .login-header h2 {
            font-weight: 600;
            color: #333333;
        }

        .login-header p {
            color: #666;
            margin-bottom: 0;
        }

        .form-label {
            font-weight: 500;
            color: #444;
        }

        .input-group-text {
            cursor: pointer;
            background-color: #fff;
            border-left: none;
        }

        .form-control {
            border-right: none;
        }

        /* Fix the input group border radius issue when using input-group */
        .input-group .form-control:first-child {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .input-group .input-group-text:last-child {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            border-left: none;
            border: 1px solid #dee2e6;
            /* Match default bootstrap border */
            border-left: 0;
        }

        .error-message {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: none;
        }
    </style>
</head>

<body>
    <a href="/" class="main-logo text-dark text-decoration-none">Dash<span>Drive</span></a>
    <div class="login-container">
        <div class="container">
            <div class="row g-0 align-items-center justify-content-center">
                <div class="col-lg-6">
                    <div class="illustration-section"></div>
                </div>
                <div class="col-lg-5">
                    <div class="login-section">
                        <div class="login-header text-center">
                            <h2>Reset Password</h2>
                            <p>Enter your new password below</p>
                        </div>

                        <% if (typeof message !=='undefined' && message) { %>
                            <div class="alert alert-danger text-center mb-4">
                                <%= message %>
                            </div>
                            <% } %>

                                <form id="resetForm" action="/vendor/reset-password" method="POST"
                                    class="needs-validation" novalidate>
                                    <input type="hidden" name="token" value="<%= token %>">

                                    <div class="mb-4">
                                        <label for="password" class="form-label">New Password</label>
                                        <div class="input-group">
                                            <input type="password" class="form-control" id="password" name="password"
                                                required>
                                            <span class="input-group-text" onclick="togglePassword('password')">
                                                <i class="fas fa-eye"></i>
                                            </span>
                                        </div>
                                        <div id="errorPassword" class="error-message"></div>
                                    </div>

                                    <div class="mb-4">
                                        <label for="confirmPassword" class="form-label">Confirm Password</label>
                                        <div class="input-group">
                                            <input type="password" class="form-control" id="confirmPassword"
                                                name="confirmPassword" required>
                                            <span class="input-group-text" onclick="togglePassword('confirmPassword')">
                                                <i class="fas fa-eye"></i>
                                            </span>
                                        </div>
                                        <div id="errorConfirmPassword" class="error-message"></div>
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100 mb-4">Reset Password</button>

                                    <p class="text-center mb-0">
                                        Remembered your password?
                                        <a href="/vendor/login" class="text-decoration-none"
                                            style="color: #333333;">Login</a>
                                    </p>
                                </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Get DOM elements
        const resetForm = document.getElementById("resetForm");
        const password = document.getElementById("password");
        const confirmPassword = document.getElementById("confirmPassword");
        const errorPassword = document.getElementById("errorPassword");
        const errorConfirmPassword = document.getElementById("errorConfirmPassword");

        // Password Toggle Functionality
        function togglePassword(fieldId) {
            const passwordField = document.getElementById(fieldId);
            const icon = event.currentTarget.querySelector("i");

            if (passwordField.type === "password") {
                passwordField.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                passwordField.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }

        // Password Validation
        function validatePassword() {
            const passVal = password.value;
            const cPassVal = confirmPassword.value;
            const passwordPattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@#$!%*?&])[A-Za-z\d@#$!%*?&]{8,}$/;
            let isValid = true;

            if (passVal.trim() === "") {
                errorPassword.style.display = "block";
                errorPassword.innerHTML = "Password is required";
                isValid = false;
            } else if (passVal.length < 8) {
                errorPassword.style.display = "block";
                errorPassword.innerHTML = "Password must be at least 8 characters";
                isValid = false;
            } else if (!passwordPattern.test(passVal)) {
                errorPassword.style.display = "block";
                errorPassword.innerHTML = "Password must include lowercase, uppercase, digit, and special character";
                isValid = false;
            } else {
                errorPassword.style.display = "none";
                errorPassword.innerHTML = "";
            }

            if (cPassVal.trim() === "") {
                errorConfirmPassword.style.display = "block";
                errorConfirmPassword.innerHTML = "Confirm password is required";
                isValid = false;
            } else if (passVal !== cPassVal) {
                errorConfirmPassword.style.display = "block";
                errorConfirmPassword.innerHTML = "Passwords do not match";
                isValid = false;
            } else {
                errorConfirmPassword.style.display = "none";
                errorConfirmPassword.innerHTML = "";
            }

            return isValid;
        }

        // Form Submission Event Listener
        document.addEventListener("DOMContentLoaded", function () {
            resetForm.addEventListener("submit", function (e) {

                // Also trigger native BS validation visual feedback if you want, 
                // but since we have custom validation, let's rely on that first.
                if (!validatePassword()) {
                    e.preventDefault();
                    e.stopPropagation();
                }

                this.classList.add('was-validated');
            });
        });
    </script>
</body>

</html>