<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - DashDrive Vendor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body {
            min-height: 100vh;
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            padding-top: 80px;
        }

        .main-logo {
            position: absolute;
            top: 20px;
            left: 30px;
            font-size: 2.5rem;
            font-weight: 700;
            text-decoration: none;
            font-family: 'Montserrat', sans-serif;
            z-index: 1000;
        }

        .main-logo span {
            color: #8bbd76;
        }

        .login-container {
            min-height: 80vh;
            display: flex;
            align-items: center;
            padding: 2rem;
        }

        .illustration-section {
            background: url('/images/Freelancers.png') no-repeat center center;
            background-size: contain;
            min-height: 500px;
            border-radius: 20px;
            position: relative;
        }

        @media (max-width: 991px) {
            .illustration-section {
                display: none;
            }
        }

        .login-section {
            background: hwb(228 78% 9% / 0.973);
            border-radius: 20px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            padding: 3rem;
        }

        .btn-primary {
            background-color: #333333;
            border-color: #333333;
            padding: 12px 20px;
            font-weight: 500;
        }

        .btn-primary:hover {
            background-color: #1a1a1a;
            border-color: #1a1a1a;
        }

        .form-control {
            padding: 12px 15px;
            border-radius: 8px;
        }

        .form-control:focus {
            border-color: #333333;
            box-shadow: 0 0 0 0.2rem rgba(51, 51, 51, 0.1);
        }

        .login-header {
            margin-bottom: 2rem;
        }

        .login-header h2 {
            font-weight: 600;
            color: #333333;
        }

        .login-header p {
            color: #666;
            margin-bottom: 0;
        }

        .form-label {
            font-weight: 500;
            color: #444;
        }

        .back-link {
            color: #333333;
            text-decoration: none;
            font-weight: 500;
        }

        .back-link:hover {
            color: #1a1a1a;
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <a href="/" class="main-logo text-dark text-decoration-none">Dash<span>Drive</span></a>
    <div class="login-container">
        <div class="container">
            <div class="row g-0 align-items-center justify-content-center">
                <div class="col-lg-6">
                    <div class="illustration-section"></div>
                </div>
                <div class="col-lg-5">
                    <div class="login-section">
                        <div class="login-header text-center">
                            <h2>Reset Password</h2>
                            <p>Enter your email to receive a reset code</p>
                        </div>

                        <% if (typeof message !=='undefined' && message) { %>
                            <div class="alert alert-danger text-center">
                                <%= message %>
                            </div>
                            <% } %>

                                <form action="/vendor/forgot-password" method="POST" class="needs-validation"
                                    novalidate>
                                    <div class="mb-4">
                                        <label for="email" class="form-label">Email address</label>
                                        <input type="email" class="form-control" id="email" name="email" required
                                            placeholder="Enter your email">
                                        <div class="invalid-feedback">Please enter a valid email address.</div>
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100 mb-4">Send OTP</button>

                                    <div class="text-center">
                                        <a href="/vendor/login" class="back-link">
                                            <i class="fas fa-arrow-left me-2"></i>Back to Login
                                        </a>
                                    </div>
                                </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Form validation
        (function () {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')

            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>