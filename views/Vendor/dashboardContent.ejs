<div class="dashboard-wrapper">
    <!-- Page Header -->
    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Dashboard</h1>
            <p class="page-subtitle">Welcome back! Here's what's happening with your listings</p>
        </div>
        <div class="header-actions">
            <div class="date-display">
                <i class="far fa-calendar-alt"></i>
                <span id="currentDate"></span>
            </div>
        </div>
    </div>

    <!-- Statistics Cards Row -->
    <div class="row stats-row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card stat-card-primary">
                <div class="stat-card-body">
                    <div class="stat-icon-wrapper">
                        <div class="stat-icon stat-icon-primary">
                            <i class="fas fa-car"></i>
                        </div>
                    </div>
                    <div class="stat-content">
                        <h6 class="stat-label">Total Cars Listed</h6>
                        <h2 class="stat-value">
                            <%= stats.totalCars || 0 %>
                        </h2>
                        <div class="stat-trend stat-trend-up">
                            <i class="fas fa-arrow-up"></i>
                            <span>12% from last month</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card stat-card-success">
                <div class="stat-card-body">
                    <div class="stat-icon-wrapper">
                        <div class="stat-icon stat-icon-success">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                    </div>
                    <div class="stat-content">
                        <h6 class="stat-label">Active Bookings</h6>
                        <h2 class="stat-value">
                            <%= stats.activeBookings || 0 %>
                        </h2>
                        <div class="stat-trend stat-trend-up">
                            <i class="fas fa-arrow-up"></i>
                            <span>8% from last month</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card stat-card-info">
                <div class="stat-card-body">
                    <div class="stat-icon-wrapper">
                        <div class="stat-icon stat-icon-info">
                            <i class="fas fa-route"></i>
                        </div>
                    </div>
                    <div class="stat-content">
                        <h6 class="stat-label">Completed Test Drives</h6>
                        <h2 class="stat-value">
                            <%= stats.completedTestDrives || 0 %>
                        </h2>
                        <div class="stat-trend stat-trend-up">
                            <i class="fas fa-arrow-up"></i>
                            <span>15% from last month</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card stat-card-warning">
                <div class="stat-card-body">
                    <div class="stat-icon-wrapper">
                        <div class="stat-icon stat-icon-warning">
                            <i class="fas fa-rupee-sign"></i>
                        </div>
                    </div>
                    <div class="stat-content">
                        <h6 class="stat-label">Monthly Earnings</h6>
                        <h2 class="stat-value">₹<%= (stats.totalEarnings || 0).toLocaleString() %>
                        </h2>
                        <div class="stat-trend stat-trend-up">
                            <i class="fas fa-arrow-up"></i>
                            <span>23% from last month</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts and Notifications Row -->
    <div class="row mb-4">
        <!-- Earnings Chart -->
        <div class="col-xl-8 mb-4">
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h5 class="chart-title">Earnings Overview</h5>
                        <p class="chart-subtitle">Monthly revenue trends</p>
                    </div>
                    <div class="chart-controls">
                        <button class="chart-btn active" data-period="weekly">Weekly</button>
                        <button class="chart-btn" data-period="monthly">Monthly</button>
                    </div>
                </div>
                <div class="chart-body">
                    <canvas id="earningsChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Notifications Panel -->
        <div class="col-xl-4 mb-4">
            <div class="notification-card">
                <div class="notification-header">
                    <h5 class="notification-title">
                        <i class="fas fa-bell"></i>
                        Recent Alerts
                    </h5>
                    <span class="notification-badge">3 New</span>
                </div>
                <div class="notification-body">
                    <div class="notification-item notification-new">
                        <div class="notification-icon notification-icon-success">
                            <i class="fas fa-calendar-plus"></i>
                        </div>
                        <div class="notification-content">
