<div class="profile-container">
    <!-- Success/Error Alerts -->
    <% if (typeof success !=='undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <% } %>
            <% if (typeof error !=='undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>


                    <!-- Profile Card -->
                    <div class="profile-card">
                        <div class="profile-header">
                            <h2 class="profile-title">
                                <i class="fas fa-user me-2"></i>Profile Information
                            </h2>
                        </div>

                        <form id="profileForm" enctype="multipart/form-data">


                            <div class="row mt-4">


                                <!-- Profile Image Column -->
                                <div class="col-lg-4 mb-4 text-center">
                                    <div class="profile-image-container mb-3 position-relative d-inline-block">
                                        <img src="<%= vendor.profileImage || 'https://ui-avatars.com/api/?name=' + (vendor.fullName || 'Vendor') %>"
                                            alt="Profile" class="img-fluid rounded-circle shadow-sm profile-preview"
                                            style="width: 150px; height: 150px; object-fit: cover; border: 4px solid #fff;">

                                        <!-- Edit Overlay -->
                                        <div class="image-upload-overlay" style="display: none;">
                                            <label for="profileImage"
                                                class="btn btn-light btn-sm rounded-circle shadow-sm p-2 cursor-pointer"
                                                title="Change Image">
                                                <i class="fas fa-camera text-primary"></i>
                                            </label>
                                        </div>
                                    </div>

                                    <input type="file" id="profileImage" name="profileImage" class="d-none"
                                        accept="image/jpeg,image/png,image/webp">


                                    <div class="invalid-feedback d-block" id="imageError" style="display: none;"></div>

                                    <!-- Business Summary (Read-only) -->
                                    <div class="card mt-4 border-0 shadow-sm bg-light">
                                        <div class="card-body p-3">
                                    
                                            <div class="d-flex justify-content-center align-items-center mb-2">
                                                <div class="display-6 fw-bold text-dark me-2">4.8</div>
                                                <div class="text-warning">
                                                    <i class="fas fa-star"></i>
                                                    <i class="fas fa-star"></i>
                                                    <i class="fas fa-star"></i>
                                                    <i class="fas fa-star"></i>
                                                    <i class="fas fa-star-half-alt"></i>
                                                </div>
                                            </div>
                                            <div class="small text-muted">Average Rating</div>
                                        </div>
                                    </div>
                                </div>


                                <!-- Personal / Business Info Column -->
                                <div class="col-lg-8 mb-4">
                                    <div class="section-header">
                                        <h4 class="section-title">
                                            <i class="fas fa-building me-2"></i>Business Info
                                        </h4>
                                    </div>

                                    <div class="mb-3">
                                        <label for="vendorName" class="form-label">Vendor Name <span
                                                class="text-danger">*</span></label>
                                        <input type="text" class="form-control profile-field" id="vendorName"
                                            name="vendorName" value="<%= vendor.fullName || '' %>" readonly required>
                                        <div class="invalid-feedback"></div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="businessName" class="form-label">Business Name <span
                                                class="text-danger">*</span></label>
                                        <input type="text" class="form-control profile-field" id="businessName"
                                            name="businessName" value="<%= vendor.companyName || '' %>" readonly
                                            required>
                                        <div class="invalid-feedback"></div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="email" class="form-label">Email</label>
                                        <input type="email" class="form-control profile-field" id="email" name="email"
                                            value="<%= vendor.email || '' %>" readonly>
                                        <small class="form-text text-muted">Email cannot be changed</small>
                                    </div>

                                    <div class="mb-3">
                                        <label for="phone" class="form-label">Phone Number <span
                                                class="text-danger">*</span></label>
                                        <input type="tel" class="form-control profile-field" id="phone" name="phone"
                                            value="<%= vendor.phone || '' %>" readonly required>
                                        <div class="invalid-feedback"></div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="gstNumber" class="form-label">GST Number <span
                                                class="text-danger">*</span></label>
                                        <input type="text" class="form-control profile-field" id="gstNumber"
                                            name="gstNumber" value="<%= vendor.taxId || '' %>" readonly required>
                                        <div class="invalid-feedback"></div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="businessAddress" class="form-label">Business Address <span
                                                class="text-danger">*</span></label>
                                        <textarea class="form-control profile-field" id="businessAddress"
                                            name="businessAddress" rows="4" readonly
                                            required><%= vendor.businessAddress || '' %></textarea>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4 text-muted opacity-25">

                            <!-- Bank & Documents Row -->
                            <div class="row mb-4">
                                <!-- Bank & Payout Details -->
                                <div class="col-lg-6 mb-4 mb-lg-0">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h4 class="section-title mb-0">
                                            <i class="fas fa-university me-2"></i>Bank & Payout
                                        </h4>
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill"
                                            data-bs-toggle="modal" data-bs-target="#bankModal">
                                            <i class="fas fa-pen me-1"></i> Manage
                                        </button>
                                    </div>

                                    <div class="card border bg-light">
                                        <div class="card-body">
                                            <div class="mb-3 border-bottom pb-2">
                                                <small class="text-muted d-block">Account Holder</small>
                                                <span class="fw-medium">
                                                    <%= vendor.bankDetails?.accountHolder || 'Not Configured' %>
                                                </span>
                                            </div>
                                            <div class="mb-3 border-bottom pb-2">
                                                <small class="text-muted d-block">Bank Name</small>
                                                <span class="fw-medium">
                                                    <%= vendor.bankDetails?.bankName || 'Not Configured' %>
                                                </span>
                                            </div>
                                            <div class="mb-3 border-bottom pb-2">
                                                <small class="text-muted d-block">Account Number</small>
                                                <span class="fw-medium font-monospace">
                                                    <%= vendor.bankDetails?.accountNumber ? '••••' +
                                                        vendor.bankDetails.accountNumber.slice(-4) : 'Not Configured' %>
                                                </span>
                                            </div>
                                            <div class="row">
                                                <div class="col-6">
                                                    <small class="text-muted d-block">IFSC Code</small>
                                                    <span class="fw-medium">
                                                        <%= vendor.bankDetails?.ifscCode || '-' %>
                                                    </span>
                                                </div>
                                                <div class="col-6">
                                                    <small class="text-muted d-block">KYC Status</small>
                                                    <% if (vendor.bankDetails?.isVerified) { %>
                                                        <span class="badge bg-success-subtle text-success"><i
                                                                class="fas fa-check-circle me-1"></i> Verified</span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning-subtle text-warning"><i
                                                                    class="fas fa-clock me-1"></i> Pending</span>
                                                            <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Documents Section -->
                                <div class="col-lg-6">
                                    <div class="section-header mb-3">
                                        <h4 class="section-title">
                                            <i class="fas fa-file-alt me-2"></i>Documents
                                        </h4>
                                    </div>

                                    <div class="card border">
                                        <div class="list-group list-group-flush">
                                            <div
                                                class="list-group-item d-flex justify-content-between align-items-center py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded p-2 me-3">
                                                        <i class="fas fa-file-contract text-primary fa-lg"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0">Business License</h6>
                                                        <small class="text-muted">Uploaded Document</small>
                                                    </div>
                                                </div>
                                                <a href="<%= vendor.documentUrl || '#' %>" target="_blank"
                                                    class="btn btn-sm btn-light border">
                                                    <i class="fas fa-eye me-1"></i> View
                                                </a>
                                            </div>
                                            <!-- Additional blocked state visual if approved -->
                                            <% if (vendor.status==='approved' ) { %>
                                                <div class="card-footer bg-light text-center small text-muted">
                                                    <i class="fas fa-lock me-1"></i> Documents can't change after verification
                                                </div>
                                                <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <!-- Action Buttons -->
                            <div class="profile-actions">
                                <button type="button" id="editBtn" class="btn btn-primary">
                                    <i class="fas fa-edit me-2"></i>Edit Profile
                                </button>
                                <button type="submit" id="saveBtn" class="btn btn-success" style="display: none;">
                                    <i class="fas fa-save me-2"></i>Save Changes
                                </button>
                                <button type="button" id="cancelBtn" class="btn btn-secondary" style="display: none;">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </button>
                            </div>
                        </form>
                    </div>
</div>

<!-- Bank Details Modal -->
<div class="modal fade" id="bankModal" tabindex="-1" aria-labelledby="bankModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="bankModalLabel">Bank & Payout Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-4">Update your bank details for payouts.</p>
                <form id="bankDetailsForm">
                    <div class="mb-3">
                        <label for="accountHolder" class="form-label">Account Holder Name</label>
                        <input type="text" class="form-control" id="accountHolder" name="accountHolder"
                            placeholder="e.g. John Doe">
                    </div>
                    <div class="mb-3">
                        <label for="bankName" class="form-label">Bank Name</label>
                        <input type="text" class="form-control" id="bankName" name="bankName"
                            placeholder="e.g. HDFC Bank">
                    </div>
                    <div class="mb-3">
                        <label for="accountNumber" class="form-label">Account Number</label>
                        <input type="password" class="form-control" id="accountNumber" name="accountNumber"
                            placeholder="Enter account number">
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label for="ifscCode" class="form-label">IFSC Code</label>
                            <input type="text" class="form-control text-uppercase" id="ifscCode" name="ifscCode"
                                placeholder="HDFC0001234">
                        </div>
                        <div class="col-6 mb-3">
                            <label for="upiId" class="form-label">UPI ID <span
                                    class="text-muted fw-normal">(Optional)</span></label>
                            <input type="text" class="form-control" id="upiId" name="upiId" placeholder="user@upi">
                        </div>
                    </div>
                    <div class="alert alert-info py-2 small">
                        <i class="fas fa-info-circle me-1"></i> Changes will require admin re-verification.
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4">Save Details</button>
            </div>
        </div>
    </div>
</div>